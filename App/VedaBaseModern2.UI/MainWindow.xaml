<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="VedaBaseModern_UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:VedaBaseModern_UI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Prabhupāda Connect"
    mc:Ignorable="d">
    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Phase 4.9.1: the native TitleBar control does not automatically
             pick up ApplicationPageBackgroundThemeBrush - left unstyled it
             renders its own default (light/white) surface regardless of the
             app's active theme, showing as an unthemed strip across the very
             top of the window above MainPage's own header. Bind it explicitly
             so both themes render one continuous surface. -->
        <TitleBar x:Name="AppTitleBar" Title="Prabhupāda Connect"
                  Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                  Foreground="{ThemeResource TextFillColorPrimaryBrush}">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <!--
            The Frame hosts pages for your application content. Add your UI to
            MainPage.xaml rather than here so you can use Page features such as
            navigation events and the Loaded lifecycle.
        -->
        <Frame x:Name="RootFrame" Grid.Row="1" />
    </Grid>
</Window>
