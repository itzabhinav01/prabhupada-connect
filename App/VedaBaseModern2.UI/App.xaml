                    <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#E8C793" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#DEBA80" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundDisabled" Color="#FAF0DC" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#E8C793" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#E0BF8A" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#D4B077" />
