                    <SolidColorBrush x:Key="ButtonForeground" Color="#111111" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#111111" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#111111" />
                    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#7A6854" />

                    <!-- SplitButton resources (Phase 4.9.2: eliminates stark white default box & hover flash) -->
                    <SolidColorBrush x:Key="SplitButtonBackground" Color="#FAF0DC" />
                    <SolidColorBrush x:Key="SplitButtonBackgroundPointerOver" Color="#E8C793" />
                    <SolidColorBrush x:Key="SplitButtonBackgroundPressed" Color="#DEBA80" />
                    <SolidColorBrush x:Key="SplitButtonBackgroundDisabled" Color="#FAF0DC" />
                    <SolidColorBrush x:Key="SplitButtonBorderBrush" Color="#DFBD86" />
                    <SolidColorBrush x:Key="SplitButtonBorderBrushPointerOver" Color="#DFBD86" />
