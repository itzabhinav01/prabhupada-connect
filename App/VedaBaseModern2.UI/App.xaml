                    <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#FAF0DC" />
                    <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#DFBD86" />
                    <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#FAF0DC" />
