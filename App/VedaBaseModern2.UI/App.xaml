                    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#DFBD86" />
                    <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#DFBD86" />
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#E8C793" />
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundPressed" Color="#DEBA80" />
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#E8C793" />
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#E0BF8A" />
