                    <SolidColorBrush x:Key="SystemAccentColor" Color="#D4AF37" />
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#D4AF37" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#C5A059" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#B08D45" />
                    <SolidColorBrush x:Key="TextControlHeaderForeground" Color="#D4AF37" />
