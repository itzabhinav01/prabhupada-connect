                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#F7E6C8" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FAF0DC" />
                    <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#F3D4A5" />
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#DFBD86" />
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#9B6818" />
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#9B6818" />
                    <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#DFBD86" />
                    <SolidColorBrush x:Key="TextControlForeground" Color="#111111" />
                    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#111111" />
                    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#111111" />
                    <SolidColorBrush x:Key="TextControlPlaceholderTextForeground" Color="#7A6854" />
                    <SolidColorBrush x:Key="TextControlPlaceholderTextForegroundPointerOver" Color="#7A6854" />
                    <SolidColorBrush x:Key="TextControlPlaceholderTextForegroundFocused" Color="#7A6854" />

                    <!-- Navigation View resources -->
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#F3D4A5" />
                    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewItemBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#E8C793" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#DEBA80" />
