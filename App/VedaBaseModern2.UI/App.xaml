                    <!-- AppBarButton / CommandBar resources -->
                    <SolidColorBrush x:Key="AppBarButtonBackgroundPointerOver" Color="#E8C793" />
                    <SolidColorBrush x:Key="AppBarButtonBackgroundPressed" Color="#DEBA80" />
                    <SolidColorBrush x:Key="AppBarToggleButtonBackgroundPointerOver" Color="#E8C793" />
                    <SolidColorBrush x:Key="AppBarToggleButtonBackgroundPressed" Color="#DEBA80" />

                    <!-- Focus Strokes -->
                    <SolidColorBrush x:Key="FocusStrokeColorOuter" Color="#9B6818" />
                    <SolidColorBrush x:Key="FocusStrokeColorInner" Color="Transparent" />
