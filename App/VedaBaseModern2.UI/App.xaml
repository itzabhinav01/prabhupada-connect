                    <SolidColorBrush x:Key="HighlightGreenBrush" Color="#4D5FA870" />
                    <SolidColorBrush x:Key="HighlightBlueBrush" Color="#4D5B93C4" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <!-- Phase 4.9.1 Light Mode: warm parchment yellow (#F3D4A5) +
                         dark black/brown typography + restrained antique gold
                         accents. Surfaces (Nav pane, cards) are kept EXTREMELY
                         close to the base tone - no separate white/gray cards -
                         so the reading environment reads as one continuous,
                         intentional surface rather than a patchwork of panels. -->
                    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#F3D4A5" />
                    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#EFCC99" />
                    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#EFCC99" />
                    <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="#EFCC99" />
                    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#F7DCAF" />
                    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#F5D8A9" />
                    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#F7DCAF" />
                    <SolidColorBrush x:Key="SystemAccentColor" Color="#9B6818" />
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#9B6818" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#8C5A13" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#7A4C0D" />
                    <SolidColorBrush x:Key="TextControlHeaderForeground" Color="#9B6818" />
                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#111111" />
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#3A3024" />
                    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#17120D" />
                    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#DFBD86" />

                    <!-- Selection highlight resources for Light Mode (Phase 4.9: Windows blue selection #2F80ED with readable white text). -->
                    <Color x:Key="TextControlSelectionHighlightColor">#2F80ED</Color>
                    <SolidColorBrush x:Key="TextControlSelectionHighlightColorThemeBrush" Color="#2F80ED" />
                    <SolidColorBrush x:Key="TextSelectionHighlightColorThemeBrush" Color="#2F80ED" />
                    <SolidColorBrush x:Key="AccentFillColorSelectedTextBackgroundBrush" Color="#2F80ED" />
                    <Color x:Key="TextOnAccentFillColorSelectedText">#FFFFFF</Color>
                    <SolidColorBrush x:Key="TextOnAccentFillColorSelectedTextBrush" Color="#FFFFFF" />

                    <!-- Highlight overlays (Phase 4.6), used for the small
                         color-swatch dot in the Highlights/Bookmarks workspace
                         lists. Translucent, not solid. Phase 4.9.5: Yellow's
                         hue refined to match the devotional Saffron color
                         (#E6A122) painted in Reading View - the "Yellow"
                         resource KEY is unchanged (it is the stable,
                         database-facing HighlightColor.Yellow identifier; see
                         HighlightColorToBrushConverter), only the visual it
                         resolves to. -->
                    <SolidColorBrush x:Key="HighlightYellowBrush" Color="#66E6A122" />
                    <SolidColorBrush x:Key="HighlightGreenBrush" Color="#666F9F7A" />
                    <SolidColorBrush x:Key="HighlightBlueBrush" Color="#665B8FC9" />

                    <!-- Phase 4.9.1: calm, subtle interactive states for Light
                         Mode. Every "flat"/subtle control (Button via the app's
                         TextBlockButtonStyle, NavigationViewItem, ListViewItem,
                         ComboBoxItem, MenuFlyoutItem) resolves its hover/pressed
                         background from the SubtleFill* family; standard Button
                         chrome resolves from the Button* family. Both are tied
                         to the same base tone here - a tonal shift within the
                         parchment family, never white or a bright/high-
                         saturation flash. Centralized here so no page needs its
                         own hardcoded hover brush. Dark Mode is untouched -
                         these keys are only defined in this Light dictionary. -->
                    <SolidColorBrush x:Key="SubtleFillColorTransparentBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#E8C793" />
                    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#DEBA80" />
                    <SolidColorBrush x:Key="SubtleFillColorDisabledBrush" Color="Transparent" />

                    <!-- Base Control Fills and Strokes -->
                    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#FAF0DC" />
                    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#E8C793" />
                    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#DEBA80" />
                    <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="#F3D4A5" />
                    <SolidColorBrush x:Key="ControlFillColorTransparentBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#DFBD86" />
                    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#DFBD86" />
                    <SolidColorBrush x:Key="ControlElevationBorderBrush" Color="#DFBD86" />
                    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#DFBD86" />
                    <SolidColorBrush x:Key="CardStrokeColorSecondaryBrush" Color="#DFBD86" />

                    <!-- Standard Button resources -->
                    <SolidColorBrush x:Key="ButtonBackground" Color="#FAF0DC" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#E8C793" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#DEBA80" />
                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#FAF0DC" />
