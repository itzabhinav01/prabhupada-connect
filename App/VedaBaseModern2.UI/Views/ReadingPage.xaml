<Page
    x:Class="VedaBaseModern.UI.Views.ReadingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:vm="using:VedaBaseModern.UI.ViewModels"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="FindAccelerator_Invoked" />
        <KeyboardAccelerator Key="Left" Modifiers="Control" Invoked="PrevAccelerator_Invoked" />
        <KeyboardAccelerator Key="Right" Modifiers="Control" Invoked="NextAccelerator_Invoked" />
        <KeyboardAccelerator Key="F11" Invoked="ZenAccelerator_Invoked" />
        <KeyboardAccelerator Key="F" Modifiers="Control,Shift" Invoked="ZenAccelerator_Invoked" />
        <KeyboardAccelerator Key="B" Modifiers="Control,Shift" Invoked="BookmarkAccelerator_Invoked" />
        <KeyboardAccelerator Key="Escape" Invoked="EscapeAccelerator_Invoked" />
        <KeyboardAccelerator Key="Add" Modifiers="Control" Invoked="ZoomInAccelerator_Invoked" />
        <KeyboardAccelerator Key="Subtract" Modifiers="Control" Invoked="ZoomOutAccelerator_Invoked" />
        <KeyboardAccelerator Key="Number0" Modifiers="Control" Invoked="ZoomResetAccelerator_Invoked" />
        <KeyboardAccelerator Key="S" Modifiers="Menu" Invoked="SplitAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Navigation & Control Bar -->
        <Grid x:Name="TopNavGrid" Grid.Row="0" Padding="16,8,16,8" Background="{ThemeResource NavigationViewDefaultPaneBackground}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Three Lines (☰), Back button & Breadcrumb -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button x:Name="SidebarToggleButton" Click="SidebarToggleButton_Click" Style="{StaticResource TextBlockButtonStyle}" Padding="6" ToolTipService.ToolTip="Toggle Library Sidebar (☰ Three Lines)">
                    <FontIcon Glyph="&#xE700;" FontSize="14" />
                </Button>
                <Button x:Name="BackButton" Click="BackButton_Click" Style="{StaticResource TextBlockButtonStyle}" Padding="6" ToolTipService.ToolTip="Back to Library (Arrow)">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                </Button>
                <ItemsControl x:Name="BreadcrumbItemsControl" ItemsSource="{x:Bind ViewModel.BreadcrumbSegments, Mode=OneWay}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:BreadcrumbSegment">
                            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                <Button Content="{x:Bind Text}" Click="BreadcrumbSegmentButton_Click" Tag="{x:Bind}"
                                        Style="{StaticResource TextBlockButtonStyle}"
                                        FontWeight="SemiBold"
                                        FontSize="14"
                                        Padding="4,2" CornerRadius="4"
                                        ToolTipService.ToolTip="Click to navigate" />
                                <TextBlock Text="›" Visibility="{x:Bind ChevronVisibility}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           VerticalAlignment="Center" Margin="2,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Navigation Controls -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button x:Name="PrevVerseButton" Command="{x:Bind ViewModel.GoPreviousCommand}" Style="{StaticResource TextBlockButtonStyle}" ToolTipService.ToolTip="Previous Verse (Ctrl+Left)">
                    <FontIcon Glyph="&#xE76B;" FontSize="12" />
                </Button>
                <Button x:Name="NextVerseButton" Command="{x:Bind ViewModel.GoNextCommand}" Style="{StaticResource TextBlockButtonStyle}" ToolTipService.ToolTip="Next Verse (Ctrl+Right)">
                    <FontIcon Glyph="&#xE76C;" FontSize="12" />
                </Button>

                <AppBarSeparator x:Name="NavSeparator1" />

                <!-- Secondary Reading Controls -->
                <StackPanel x:Name="SecondaryControlsPanel" Orientation="Horizontal" Spacing="6">
                    <!-- Continuous Chapter vs Single Verse Toggle -->
                    <Button x:Name="ViewModeToggleButton" Click="ViewModeToggleButton_Click" Style="{StaticResource TextBlockButtonStyle}" ToolTipService.ToolTip="Toggle Verse / Continuous Chapter View">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon x:Name="ViewModeIcon" Glyph="&#xE8A5;" FontSize="14" />
                            <TextBlock x:Name="ViewModeText" Text="Continuous View" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- In-page Find Button -->
                    <Button x:Name="FindButton" Click="FindButton_Click" Style="{StaticResource TextBlockButtonStyle}" ToolTipService.ToolTip="Find in page (Ctrl+F)">
                        <FontIcon Glyph="&#xE721;" FontSize="14" />
                    </Button>

                    <!-- Bookmark Button -->
                    <Button x:Name="BookmarkButton" Command="{x:Bind ViewModel.ToggleBookmarkCommand}" Style="{StaticResource TextBlockButtonStyle}" ToolTipService.ToolTip="Bookmark this verse">
                        <FontIcon Glyph="&#xE8A4;" FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                    </Button>

                    <!-- Dual Pane / Split View Button -->
                    <Button x:Name="SplitViewToggleButton" Click="SplitViewToggleButton_Click" Style="{StaticResource TextBlockButtonStyle}" ToolTipService.ToolTip="Split View / Dual Pane Reading (Alt+S)">
                        <FontIcon Glyph="&#xE7C4;" FontSize="14" />
                    </Button>
                </StackPanel>

                <!-- Focus / Zen Mode Button (vedabase.io style) -->
                <Button x:Name="ZenModeToggleButton" Click="ZenModeToggleButton_Click" Style="{StaticResource TextBlockButtonStyle}" ToolTipService.ToolTip="Focus View (F11)">
                    <FontIcon x:Name="ZenModeIcon" Glyph="&#xE740;" FontSize="14" Foreground="#E5A93C" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Reader Container: Microsoft WebView2 & Side-by-Side Dual Pane -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftPaneCol" Width="*" />
                <ColumnDefinition x:Name="SplitterCol" Width="Auto" />
                <ColumnDefinition x:Name="RightPaneCol" Width="0" />
            </Grid.ColumnDefinitions>

            <!-- Main Left Reader Pane -->
            <Grid Grid.Column="0">
                <controls:WebView2 x:Name="ReaderWebView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

                <!-- Loading Spinner -->
                <ProgressRing x:Name="LoadingRing" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center" />

                <!-- Floating Exit Focus Button (Only shown in Zen/Focus Mode) -->
                <Button x:Name="FloatingZenExitButton" Visibility="Collapsed"
                        Click="ZenModeToggleButton_Click"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,16,24,0" Padding="10,6"
                        CornerRadius="20"
                        Opacity="0.85"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        ToolTipService.ToolTip="Exit Focus View (Esc or F11)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE73F;" FontSize="13" Foreground="#E5A93C" />
                        <TextBlock Text="Exit Focus" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Floating Centered Find Bar (Ctrl+F) with Browser-Style Toggles -->
                <Border x:Name="FindBarCard" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Top"
                        Margin="0,16,0,0" Padding="8,4,8,4"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE721;" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="2,0,0,0" />
                        <TextBox x:Name="FindQueryBox" Width="220" PlaceholderText="Find in page (Ctrl+F)..."
                                 TextChanged="FindQueryBox_TextChanged" KeyDown="FindQueryBox_KeyDown" Height="32" FontSize="13" />
                        
                        <!-- Browser-Style In-Line Toggles: Match Case & Match Whole Word -->
                        <ToggleButton x:Name="FindMatchCaseToggle" Click="FindOption_Toggled"
                                      ToolTipService.ToolTip="Match Case (Alt+C)"
                                      Width="32" Height="32" Padding="0" CornerRadius="4">
                            <TextBlock Text="Aa" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </ToggleButton>
                        <ToggleButton x:Name="FindMatchWordToggle" Click="FindOption_Toggled"
                                      ToolTipService.ToolTip="Match Whole Word (Alt+W)"
                                      Width="36" Height="32" Padding="0" CornerRadius="4">
                            <TextBlock Text="[ab]" FontWeight="Bold" FontSize="11" FontFamily="Consolas, Segoe UI" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </ToggleButton>

                        <TextBlock x:Name="FindCounterText" Text="0 of 0" VerticalAlignment="Center"
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="6,0,4,0" MinWidth="40" TextAlignment="Center" />
                        <Button x:Name="FindPrevButton" Click="FindPrevButton_Click" Style="{StaticResource TextBlockButtonStyle}" Padding="6" ToolTipService.ToolTip="Previous match (Shift+Enter)">
                            <FontIcon Glyph="&#xE70E;" FontSize="12" />
                        </Button>
                        <Button x:Name="FindNextButton" Click="FindNextButton_Click" Style="{StaticResource TextBlockButtonStyle}" Padding="6" ToolTipService.ToolTip="Next match (Enter)">
                            <FontIcon Glyph="&#xE70D;" FontSize="12" />
                        </Button>
                        <Button x:Name="FindCloseButton" Click="FindCloseButton_Click" Style="{StaticResource TextBlockButtonStyle}" Padding="6" ToolTipService.ToolTip="Close (Esc)">
                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Splitter Divider -->
            <Border x:Name="SplitterBorder" Grid.Column="1" Width="4" Visibility="Collapsed"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" HorizontalAlignment="Center" VerticalAlignment="Stretch" />

            <!-- Right Pane: Side-by-Side Dual View (Parallel Scripture or Active Side Notebook) -->
            <Grid x:Name="RightPaneContainer" Grid.Column="2" Visibility="Collapsed"
                  Background="{ThemeResource LayerFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Right Pane Header: Mode Switcher & Close -->
                <Grid Grid.Row="0" Padding="12,8" Background="{ThemeResource NavigationViewDefaultPaneBackground}"
                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button x:Name="ParallelScriptureTabBtn" Click="ParallelScriptureTabBtn_Click"
                                Style="{StaticResource DefaultButtonStyle}" Padding="10,4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8A5;" FontSize="12" />
                                <TextBlock x:Name="ParallelTabLabel" Text="Parallel Scripture" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="SideNotebookTabBtn" Click="SideNotebookTabBtn_Click"
                                Style="{StaticResource TextBlockButtonStyle}" Padding="10,4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE70F;" FontSize="12" />
                                <TextBlock x:Name="SideNotebookTabLabel" Text="Realization Notebook" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Button Grid.Column="1" x:Name="CloseSplitViewBtn" Click="CloseSplitViewBtn_Click"
                            Style="{StaticResource TextBlockButtonStyle}" Padding="6" ToolTipService.ToolTip="Close Split View (Alt+S)">
                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                    </Button>
                </Grid>

                <!-- Mode A: Parallel Scripture View -->
                <Grid x:Name="ParallelScripturePanel" Grid.Row="1" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Scripture Search & Paging Bar -->
                    <Grid Grid.Row="0" Padding="12,8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <AutoSuggestBox x:Name="ParallelVerseSuggestBox"
                                        PlaceholderText="Compare verse e.g. BG 2.13, SB 1.1.1..."
                                        QuerySubmitted="ParallelVerseSuggestBox_QuerySubmitted"
                                        QueryIcon="Find" HorizontalAlignment="Stretch" VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0" VerticalAlignment="Center">
                            <Button x:Name="ParallelPrevBtn" Click="ParallelPrevBtn_Click"
                                    Style="{StaticResource TextBlockButtonStyle}" Padding="6" ToolTipService.ToolTip="Previous Verse">
                                <FontIcon Glyph="&#xE76B;" FontSize="12" />
                            </Button>
                            <Button x:Name="ParallelNextBtn" Click="ParallelNextBtn_Click"
                                    Style="{StaticResource TextBlockButtonStyle}" Padding="6" ToolTipService.ToolTip="Next Verse">
                                <FontIcon Glyph="&#xE76C;" FontSize="12" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Parallel Reader WebView2 -->
                    <Grid Grid.Row="1">
                        <controls:WebView2 x:Name="ParallelWebView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        <ProgressRing x:Name="ParallelLoadingRing" Width="36" Height="36"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                    </Grid>
                </Grid>

                <!-- Mode B: Active Realization Notebook -->
                <Grid x:Name="SideNotebookPanel" Grid.Row="1" Visibility="Collapsed" Padding="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Note Title -->
                    <TextBox x:Name="SideNoteTitleBox" Grid.Row="0"
                             PlaceholderText="Realization Title (e.g. Surrender to Krishna)"
                             Margin="0,0,0,8" />

                    <!-- Quick Tag Chips -->
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Quick Tags:" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <Button Content="#surrender" Click="QuickTagButton_Click" Style="{StaticResource TextBlockButtonStyle}" Padding="6,2" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" />
                            <Button Content="#guru-tattva" Click="QuickTagButton_Click" Style="{StaticResource TextBlockButtonStyle}" Padding="6,2" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" />
                            <Button Content="#bhakti" Click="QuickTagButton_Click" Style="{StaticResource TextBlockButtonStyle}" Padding="6,2" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" />
                            <Button Content="#sadhana" Click="QuickTagButton_Click" Style="{StaticResource TextBlockButtonStyle}" Padding="6,2" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" />
                            <Button Content="#sambandha" Click="QuickTagButton_Click" Style="{StaticResource TextBlockButtonStyle}" Padding="6,2" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Note Markdown / Reflection Body -->
                    <TextBox x:Name="SideNoteContentBox" Grid.Row="2" AcceptsReturn="True" TextWrapping="Wrap"
                             PlaceholderText="Write personal reflections, realizations, #tags, and [[WikiLinks]] side-by-side with scripture..."
                             VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="0,0,0,8" />

                    <!-- Bottom Action Bar -->
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="SideNoteStatusText" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="SideNoteClearBtn" Click="SideNoteClearBtn_Click" Content="Clear" Style="{StaticResource TextBlockButtonStyle}" />
                            <Button x:Name="SideNoteSaveBtn" Click="SideNoteSaveBtn_Click" Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE74E;" FontSize="12" />
                                    <TextBlock Text="Save Realization" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
