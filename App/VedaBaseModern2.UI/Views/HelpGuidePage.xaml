<Page
    x:Class="VedaBaseModern.UI.Views.HelpGuidePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <Style x:Key="GuideExpanderStyle" TargetType="Expander">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="CodeBoxStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,8,0,8" />
        </Style>

        <Style x:Key="TipBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
            <Setter Property="CornerRadius" Value="0,6,6,0" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,8,0,8" />
        </Style>
    </Page.Resources>

    <Grid>
        <ScrollViewer x:Name="MainScrollViewer" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="28,20,28,48">
            <StackPanel MaxWidth="1040" HorizontalAlignment="Stretch" Spacing="14">

                <!-- Header Title & Quick Search -->
                <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="26,20">
                    <StackPanel Spacing="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <Border Width="36" Height="36" CornerRadius="18" VerticalAlignment="Center">
                                        <Border.Background>
                                            <ImageBrush ImageSource="ms-appx:///Assets/Square44x44Logo.scale-200.png" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                    <TextBlock Text="Prabhupāda Connect User Manual &amp; Research Guide" Style="{StaticResource TitleTextBlockStyle}" FontSize="22" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Complete, searchable in-app reference for scripture reading, Sanskrit meters, Folio advanced search, book ingestion, and cloud sync."
                                           Style="{StaticResource BodyTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Content="Expand All" Click="ExpandAll_Click" Style="{StaticResource DefaultButtonStyle}" FontSize="12" />
                                <Button Content="Collapse All" Click="CollapseAll_Click" Style="{StaticResource DefaultButtonStyle}" FontSize="12" />
                            </StackPanel>
                        </Grid>

                        <!-- Live Search / Topic Filter -->
                        <TextBox x:Name="SearchFilterBox"
                                 PlaceholderText="🔍 Search manual (e.g. meter, audio, split view, prompt, import book, folio, proximity, supabase, purports)..."
                                 TextChanged="SearchFilterBox_TextChanged"
                                 HorizontalAlignment="Stretch" Padding="12,10" CornerRadius="6" />

                        <!-- Category Quick-Jump Chips -->
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="All Topics" Click="CategoryChip_Click" Tag="All" Style="{StaticResource DefaultButtonStyle}" FontSize="12" />
                                <Button Content="1. Reading View" Click="CategoryChip_Click" Tag="Nav" Style="{StaticResource DefaultButtonStyle}" FontSize="12" />
                                <Button Content="2. Split View" Click="CategoryChip_Click" Tag="Split" Style="{StaticResource DefaultButtonStyle}" FontSize="12" />
                                <Button Content="3. Zen Focus Mode" Click="CategoryChip_Click" Tag="Zen" Style="{StaticResource DefaultButtonStyle}" FontSize="12" />
                                <Button Content="4. Sanskrit Meters" Click="CategoryChip_Click" Tag="Meter" Style="{StaticResource DefaultButtonStyle}" FontSize="12" />
                                <Button Content="5. Advanced Search" Click="CategoryChip_Click" Tag="Search" Style="{StaticResource DefaultButtonStyle}" FontSize="12" />
                                <Button Content="6. Sanskrit Lexicon" Click="CategoryChip_Click" Tag="Lexicon" Style="{StaticResource DefaultButtonStyle}" FontSize="12" />
                                <Button Content="7. Notes &amp; Obsidian" Click="CategoryChip_Click" Tag="Notes" Style="{StaticResource DefaultButtonStyle}" FontSize="12" />
                                <Button Content="8. Adding Books &amp; AI Prompt" Click="CategoryChip_Click" Tag="AddBooks" Style="{StaticResource DefaultButtonStyle}" FontSize="12" />
                                <Button Content="9. Supabase Sync" Click="CategoryChip_Click" Tag="Supabase" Style="{StaticResource DefaultButtonStyle}" FontSize="12" />
                                <Button Content="10. Shortcuts" Click="CategoryChip_Click" Tag="Shortcuts" Style="{StaticResource DefaultButtonStyle}" FontSize="12" />
                                <Button Content="11. FAQ &amp; Troubleshooting" Click="CategoryChip_Click" Tag="FAQ" Style="{StaticResource DefaultButtonStyle}" FontSize="12" />
                            </StackPanel>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- Status / Import Result InfoBar -->
                <InfoBar x:Name="StatusInfoBar" IsOpen="False" Severity="Informational" Margin="0,0,0,4" />

                <!-- SECTION 1: Reading View & Verse Navigation -->
                <Expander x:Name="ExpanderNav" Style="{StaticResource GuideExpanderStyle}" IsExpanded="True" Tag="reading navigation devanagari transliteration synonyms translation purport breadcrumb previous next">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE736;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="1. Scriptural Reading View &amp; Navigation" FontWeight="SemiBold" FontSize="14" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Spacing="12" Padding="6,10,6,12">
                        <TextBlock Text="The Reading View is the heart of VedaBase Modern, engineered for high-fidelity study of Śrīla Prabhupāda's canonical scriptures and books with 60fps hardware-accelerated rendering." TextWrapping="Wrap" />

                        <TextBlock Text="Authentic Six-Fold Verse Hierarchy:" FontWeight="SemiBold" />
                        <StackPanel Spacing="6" Margin="12,0,0,0">
                            <TextBlock Text="• Devanagari Sanskrit: Authentic sacred script rendered in high-resolution Unicode typography." TextWrapping="Wrap" />
                            <TextBlock Text="• IAST Roman Transliteration: Accurate international transliteration with full diacritical marks (e.g. kṛṣṇa, dharma)." TextWrapping="Wrap" />
                            <TextBlock Text="• Word-by-Word Synonyms: Every Sanskrit lemma is individually mapped. Click any Sanskrit word to immediately trigger a reverse concordance search across all 46 books." TextWrapping="Wrap" />
                            <TextBlock Text="• Translation: Authentic English translation by His Divine Grace A.C. Bhaktivedanta Swami Prabhupāda." TextWrapping="Wrap" />
                            <TextBlock Text="• Bhaktivedanta Purport Commentary: Complete, uncompressed purports with authentic poetic verse quotations, Sanskrit citations, and chapter references." TextWrapping="Wrap" />
                        </StackPanel>

                        <Border Style="{StaticResource TipBorderStyle}">
                            <TextBlock Text="💡 Quick Tip: Use Alt+Left and Alt+Right arrow keys to navigate consecutively between verses without touching the mouse." TextWrapping="Wrap" FontSize="12" />
                        </Border>
                    </StackPanel>
                </Expander>

                <!-- SECTION 2: Split View Study -->
                <Expander x:Name="ExpanderSplit" Style="{StaticResource GuideExpanderStyle}" IsExpanded="False" Tag="split view side by side parallel comparative compare verses">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE7F4;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="2. Split-View Comparative Study" FontWeight="SemiBold" FontSize="14" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Spacing="12" Padding="6,10,6,12">
                        <TextBlock Text="Study two texts simultaneously side-by-side. Ideal for comparing Bhagavad-gītā verses with corresponding Śrīmad-Bhāgavatam purports or Caitanya-caritāmṛta pastimes." TextWrapping="Wrap" />

                        <TextBlock Text="How to Use Split-View:" FontWeight="SemiBold" />
                        <StackPanel Spacing="6" Margin="12,0,0,0">
                            <TextBlock Text="1. Click the Split-View icon in the reading toolbar." TextWrapping="Wrap" />
                            <TextBlock Text="2. A secondary reader pane opens immediately on the right." TextWrapping="Wrap" />
                            <TextBlock Text="3. Enter any verse reference (e.g., 'SB 1.2.6' or 'BG 4.9') in the top address bar of either pane to load it independently." TextWrapping="Wrap" />
                            <TextBlock Text="4. Scroll either pane independently, or use the Synchronized Scrolling toggle to lock both columns together." TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Expander>

                <!-- SECTION 3: Zen Focus Mode -->
                <Expander x:Name="ExpanderZen" Style="{StaticResource GuideExpanderStyle}" IsExpanded="False" Tag="zen focus mode purports distraction free escape reading width font line spacing">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE740;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="3. Zen Focus Mode &amp; Purports" FontWeight="SemiBold" FontSize="14" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Spacing="12" Padding="6,10,6,12">
                        <TextBlock Text="Press Ctrl+Shift+F at any time to enter Zen Focus Mode. This immediately hides all navigation drawers, tab headers, and window borders for an uninterrupted, contemplative reading experience." TextWrapping="Wrap" />

                        <Border Style="{StaticResource TipBorderStyle}">
                            <TextBlock Text="📖 Full Purport Guarantee: Purports are ALWAYS included in Focus Mode! You can customize Reading Column Width (Standard 680px, Wide 820px, Full Width) and Line Spacing directly in Settings or via the reading toolbar." TextWrapping="Wrap" FontSize="12" />
                        </Border>

                        <TextBlock Text="• Press Escape or Ctrl+Shift+F to instantly exit Focus Mode and return to your full workspace." TextWrapping="Wrap" />
                    </StackPanel>
                </Expander>

                <!-- SECTION 4: Sanskrit Prosody & Meter Chanting -->
                <Expander x:Name="ExpanderMeter" Style="{StaticResource GuideExpanderStyle}" IsExpanded="False" Tag="sanskrit meter prosody chanting anustubh tristubh mandakranta sardulavikridita caesura yati pause audio">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xEC15;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="4. Classical Sanskrit Prosody &amp; Meter Chanting Guides" FontWeight="SemiBold" FontSize="14" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Spacing="12" Padding="6,10,6,12">
                        <TextBlock Text="VedaBase Modern includes a built-in classical Sanskrit prosodic scanner that automatically analyzes the poetic meter of every verse and provides chanting guidance." TextWrapping="Wrap" />

                        <TextBlock Text="The 4 Classical Vedic Meters Detected:" FontWeight="SemiBold" />
                        <StackPanel Spacing="8" Margin="12,0,0,0">
                            <TextBlock Text="1. Anuṣṭubh (Śloka) — 32 Syllables (4 quarters × 8 syllables). The most common meter of Bhagavad-gītā, Śrīmad-Bhāgavatam, and Mahābhārata." TextWrapping="Wrap" />
                            <TextBlock Text="2. Triṣṭubh — 44 Syllables (4 quarters × 11 syllables). Heroic Vedic meter used in profound prayers and Bhagavad-gītā Chapter 11 (Universal Form)." TextWrapping="Wrap" />
                            <TextBlock Text="3. Mandākrāntā — 68 Syllables (4 quarters × 17 syllables). Majestic, contemplative meter with a classical 4-6-7 syllable pause cadence." TextWrapping="Wrap" />
                            <TextBlock Text="4. Śārdūlavikrīḍita — 76 Syllables (4 quarters × 19 syllables). 'The Tiger's Play' — powerful classical meter with a 12-7 cadence (e.g. Govindam ādi-puruṣaṁ prayers)." TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBlock Text="Interactive Features:" FontWeight="SemiBold" Margin="0,4,0,0" />
                        <TextBlock Text="• Visual Caesura (Yati) Markers: Blue pause indicators (|) mark authentic Sanskrit breathing pauses." TextWrapping="Wrap" />
                        <TextBlock Text="• Audio Chanting Pulse: Click the speaker badge beside any recognized meter to start the rhythmic chanting metronome synthesizer." TextWrapping="Wrap" />
                    </StackPanel>
                </Expander>

                <!-- SECTION 5: Folio Advanced Search Suite Guide -->
                <Expander x:Name="ExpanderSearch" Style="{StaticResource GuideExpanderStyle}" IsExpanded="False" Tag="folio advanced search word wheel proximity near w/5 w/10 boolean and or not phrase checked branches f3 next hit">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE71E;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="5. Folio Advanced Search Suite &amp; Operator Reference" FontWeight="SemiBold" FontSize="14" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Spacing="14" Padding="6,10,6,12">
                        <TextBlock Text="Designed after the legendary Folio Views Bhaktivedanta VedaBase search engine, upgraded with SQLite FTS5 index performance, live corpus vocabulary, proximity matching, and in-reader hit navigation." TextWrapping="Wrap" />

                        <TextBlock Text="How to Open: Click '⚡ Advanced Search (Folio)' in the 3-line left pane, or press Ctrl+Shift+S." FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />

                        <!-- Word Wheel -->
                        <TextBlock Text="1. The Corpus Word Wheel:" FontWeight="SemiBold" />
                        <TextBlock Text="Connects directly to the live corpus index table. As you type into the 'Word:' box, the list instantly scrolls alphabetically. Next to each word, an amber badge displays the exact number of documents containing that term. Pressing Enter or double-clicking any word appends it into your query." TextWrapping="Wrap" />

                        <!-- Query Operators Table -->
                        <TextBlock Text="2. Query Operators Explained with Concrete Examples:" FontWeight="SemiBold" />
                        <Grid ColumnSpacing="12" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Operator" FontWeight="Bold" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Example Query" FontWeight="Bold" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="What It Does" FontWeight="Bold" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="AND" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="krishna AND arjuna" FontFamily="Consolas" FontSize="12" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Finds records containing BOTH 'krishna' and 'arjuna' anywhere in the text." TextWrapping="Wrap" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="OR" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="bhakti OR prema" FontFamily="Consolas" FontSize="12" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Finds records containing EITHER 'bhakti', 'prema', or both." TextWrapping="Wrap" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="NOT" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="krishna NOT maya" FontFamily="Consolas" FontSize="12" />
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="Finds records mentioning 'krishna' but strictly excluding any mention of 'maya'." TextWrapping="Wrap" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="w/5 (Proximity)" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="krishna w/5 arjuna" FontFamily="Consolas" FontSize="12" />
                            <TextBlock Grid.Row="4" Grid.Column="2" Text="Finds records where 'krishna' and 'arjuna' occur within 5 words of each other." TextWrapping="Wrap" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="w/10 (Proximity)" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="bhakti w/10 surrender" FontFamily="Consolas" FontSize="12" />
                            <TextBlock Grid.Row="5" Grid.Column="2" Text="Finds records where 'bhakti' and 'surrender' occur within 10 words of each other." TextWrapping="Wrap" />

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="[ &quot;Phrase&quot; ]" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="&quot;supreme personality&quot;" FontFamily="Consolas" FontSize="12" />
                            <TextBlock Grid.Row="6" Grid.Column="2" Text="Finds exact verbatim phrase matches in exact order." TextWrapping="Wrap" />
                        </Grid>

                        <!-- Diacritic Tolerance & Scoping -->
                        <TextBlock Text="3. Diacritic-Tolerant Matching:" FontWeight="SemiBold" Margin="0,6,0,0" />
                        <TextBlock Text="You do not need diacritical characters to find verses. Typing 'sankirtan' automatically matches 'saṅkīrtana', 'radha' matches 'rādhā', and 'gaura' matches 'gaurāṅga'." TextWrapping="Wrap" />

                        <!-- Checked Branches -->
                        <TextBlock Text="4. Checked Branches (Multi-Book Scoping):" FontWeight="SemiBold" Margin="0,6,0,0" />
                        <TextBlock Text="Filter your search to any subset of the 46 canonical books. Use one-click presets like [Scriptures Only] (BG, SB, CC) or [Biographies Only] (Prabhupāda-līlāmṛta)." TextWrapping="Wrap" />

                        <!-- In-Reader Hit Navigation -->
                        <TextBlock Text="5. In-Reader Hit-to-Hit Navigation (F3 / Shift+F3):" FontWeight="SemiBold" Margin="0,6,0,0" />
                        <TextBlock Text="When you open a verse from search results, all matching terms are highlighted in golden rings. A floating HUD appears at bottom-right:" TextWrapping="Wrap" />
                        <Border Style="{StaticResource TipBorderStyle}">
                            <TextBlock Text="Press F3 to jump to the next hit, Shift+F3 for previous hit, and Escape to dismiss." TextWrapping="Wrap" FontSize="12" />
                        </Border>
                    </StackPanel>
                </Expander>

                <!-- SECTION 6: Sanskrit Reverse Lexicon -->
                <Expander x:Name="ExpanderLexicon" Style="{StaticResource GuideExpanderStyle}" IsExpanded="False" Tag="sanskrit reverse lexicon concordance lemma root dictionary word occurrences">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8D2;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="6. Sanskrit Reverse Lexicon &amp; Concordance" FontWeight="SemiBold" FontSize="14" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Spacing="12" Padding="6,10,6,12">
                        <TextBlock Text="Clicking any word in the Sanskrit synonyms list opens the interactive Concordance Drawer. It reveals:" TextWrapping="Wrap" />
                        <StackPanel Spacing="6" Margin="12,0,0,0">
                            <TextBlock Text="• Total occurrences of that exact inflected Sanskrit lemma across the entire VedaBase." TextWrapping="Wrap" />
                            <TextBlock Text="• Breakdown by book (e.g. 11 in Bhagavad-gītā, 84 in Śrīmad-Bhāgavatam)." TextWrapping="Wrap" />
                            <TextBlock Text="• Click any occurrence in the concordance drawer to jump directly to that verse in a new tab." TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Expander>

                <!-- SECTION 7: Notes, Wiki-Links & Obsidian -->
                <Expander x:Name="ExpanderNotes" Style="{StaticResource GuideExpanderStyle}" IsExpanded="False" Tag="notes highlights bookmarks markdown obsidian logseq wiki links tags export">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE70B;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="7. Personal Study: Notes, Wiki-Links, #Tags &amp; Obsidian Export" FontWeight="SemiBold" FontSize="14" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Spacing="12" Padding="6,10,6,12">
                        <TextBlock Text="VedaBase Modern provides a full Markdown knowledge base integrated with your personal realizations." TextWrapping="Wrap" />

                        <TextBlock Text="• Bidirectional Verse Wiki-Links:" FontWeight="SemiBold" />
                        <TextBlock Text="Type [[BG 18.66]] or [[SB 1.2.6]] anywhere in your notes. They automatically transform into golden clickable hyperlinks that navigate directly to the verse." TextWrapping="Wrap" />

                        <TextBlock Text="• Hashtag Categorization:" FontWeight="SemiBold" Margin="0,4,0,0" />
                        <TextBlock Text="Add tags like #guru-tattva, #surrender, or #sambandha to categorize your research. Filter notes instantly by clicking tags in your Notes view." TextWrapping="Wrap" />

                        <TextBlock Text="• Export to Obsidian / Logseq:" FontWeight="SemiBold" Margin="0,4,0,0" />
                        <TextBlock Text="Because notes use standard Markdown, wiki-links ([[Verse]]), and hashtags (#tag), they seamlessly connect into Obsidian graph views and personal knowledge vaults." TextWrapping="Wrap" />
                    </StackPanel>
                </Expander>

                <!-- SECTION 8: Adding Books & Universal AI Conversion Prompt -->
                <Expander x:Name="ExpanderAddBooks" Style="{StaticResource GuideExpanderStyle}" IsExpanded="True" Tag="adding books ingestion import book ai prompt chatgpt claude gemini json pdf rtf word convert">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8B7;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="8. Ingestion, Custom Books &amp; Universal AI Conversion Prompt" FontWeight="SemiBold" FontSize="14" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Spacing="14" Padding="6,10,6,12">
                        <TextBlock Text="You can easily expand VedaBase Modern with additional books, commentaries, and transcriptions directly from PDF files (no conversion required!) or from VedaBase JSON archives." TextWrapping="Wrap" />

                        <!-- In-App Import Action Card -->
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="2" CornerRadius="8" Padding="16,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="📁 In-App Book Importer (PDF &amp; JSON)" FontWeight="Bold" FontSize="15" />
                                    <TextBlock Text="Import spiritual books directly as PDFs, or pick any VedaBase-compatible JSON file to ingest into your local library and search index."
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Click="ImportPdfButton_Click" Style="{StaticResource AccentButtonStyle}" Padding="14,8">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xEA90;" FontSize="14" />
                                            <TextBlock Text="Import PDF Book Directly..." FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="ImportBookButton_Click" Style="{StaticResource DefaultButtonStyle}" Padding="14,8">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE898;" FontSize="14" />
                                            <TextBlock Text="Import JSON Book..." FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- How to Convert with AI Prompt -->
                        <TextBlock Text="How to Convert Any Book (PDF, Word .docx, RTF, Scanned Text) Using AI:" FontWeight="SemiBold" FontSize="14" Margin="0,6,0,0" />
                        <TextBlock Text="You can convert any text into the exact JSON format required by VedaBase Modern using ChatGPT, Claude, or Gemini. Simply copy the Universal AI Prompt below, attach or paste your book chapters, and the AI will generate the ready-to-import JSON file." TextWrapping="Wrap" />

                        <!-- Copy Prompt Card -->
                        <Border Style="{StaticResource CodeBoxStyle}">
                            <StackPanel Spacing="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Universal AI Book Conversion Prompt" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Click="CopyAiPrompt_Click" Style="{StaticResource DefaultButtonStyle}" Padding="10,6">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE8C8;" FontSize="13" />
                                            <TextBlock Text="Copy AI Prompt" FontSize="12" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBox x:Name="AiPromptTextBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                         FontFamily="Consolas" FontSize="11" Height="220" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="After receiving the JSON response from your AI model:" FontWeight="SemiBold" Margin="0,4,0,0" />
                        <TextBlock Text="1. Save the AI's output as a .json file (e.g., 'MyBook.json')." Margin="12,0,0,0" />
                        <TextBlock Text="2. Click the 'Import Book from JSON...' button above and select the file." Margin="12,0,0,0" />
                        <TextBlock Text="3. The book will immediately appear in your Library and will be indexed for instant Full-Text Search!" Margin="12,0,0,0" />
                    </StackPanel>
                </Expander>

                <!-- SECTION 9: Supabase Cloud Sync -->
                <Expander x:Name="ExpanderSupabase" Style="{StaticResource GuideExpanderStyle}" IsExpanded="False" Tag="supabase cloud sync setup sql schema backup cross device database url anon key">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE753;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="9. Supabase Cloud Sync Setup Guide (Elaborate Step-by-Step)" FontWeight="SemiBold" FontSize="14" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Spacing="14" Padding="6,10,6,12">
                        <TextBlock Text="Sync your bookmarks, notes, and highlights seamlessly across all your Windows devices using a free, self-hosted or hosted Supabase PostgreSQL backend." TextWrapping="Wrap" />

                        <TextBlock Text="Step 1: Create a Free Supabase Project" FontWeight="SemiBold" />
                        <TextBlock Text="Go to https://supabase.com and sign up. Click 'New Project', select your region, and choose a secure database password." Margin="12,0,0,0" TextWrapping="Wrap" />

                        <TextBlock Text="Step 2: Run the Database Schema SQL Script" FontWeight="SemiBold" Margin="0,4,0,0" />
                        <TextBlock Text="In your Supabase dashboard, click 'SQL Editor' in the left menu. Click 'New Query', paste the SQL script below, and click 'Run'." Margin="12,0,0,0" TextWrapping="Wrap" />

                        <!-- Copy SQL Script Card -->
                        <Border Style="{StaticResource CodeBoxStyle}">
                            <StackPanel Spacing="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Supabase SQL Migration Script" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Click="CopySupabaseSql_Click" Style="{StaticResource DefaultButtonStyle}" Padding="10,6">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE8C8;" FontSize="13" />
                                            <TextBlock Text="Copy SQL Script" FontSize="12" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBox x:Name="SupabaseSqlTextBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                         FontFamily="Consolas" FontSize="11" Height="220" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Step 3: Connect in VedaBase Modern Settings" FontWeight="SemiBold" Margin="0,4,0,0" />
                        <StackPanel Spacing="6" Margin="12,0,0,0">
                            <TextBlock Text="1. In Supabase, go to Project Settings > API." TextWrapping="Wrap" />
                            <TextBlock Text="2. Copy your Project URL (e.g., https://xyzcompany.supabase.co)." TextWrapping="Wrap" />
                            <TextBlock Text="3. Copy your Project API Key ('anon' / 'public')." TextWrapping="Wrap" />
                            <TextBlock Text="4. In VedaBase Modern, open Settings (gear icon in left sidebar) > Cloud Sync." TextWrapping="Wrap" />
                            <TextBlock Text="5. Paste the URL and Key into their respective fields and click 'Test Connection &amp; Sync'." TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Expander>

                <!-- SECTION 10: Keyboard Shortcuts -->
                <Expander x:Name="ExpanderShortcuts" Style="{StaticResource GuideExpanderStyle}" IsExpanded="False" Tag="keyboard shortcuts hotkeys f1 ctrl+shift+s ctrl+shift+f f3 escape">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE765;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="10. Complete Keyboard Shortcuts Cheatsheet" FontWeight="SemiBold" FontSize="14" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Spacing="10" Padding="6,10,6,12">
                        <Grid ColumnSpacing="16" RowSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Shortcut" FontWeight="Bold" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Action" FontWeight="Bold" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="F1" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Open User Manual &amp; Research Guide" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Ctrl + Left / Right" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="Navigate to Previous / Next verse or page (also Alt + Left/Right)" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Ctrl + + / - / 0" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="Zoom In, Zoom Out, and Reset Zoom (also Ctrl + MouseWheel)" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Ctrl + Shift + F" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="Toggle True Focus View (distraction-free, zero HUD until Esc)" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Ctrl + Shift + S" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="Open Folio Advanced Search Dialog &amp; Word Wheel" />

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Ctrl + Shift + L" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="Toggle Light / Dark theme" />

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Ctrl + Shift + B" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Grid.Row="7" Grid.Column="1" Text="Bookmark / unbookmark active verse" />

                            <TextBlock Grid.Row="8" Grid.Column="0" Text="Ctrl + K / Ctrl + F" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Grid.Row="8" Grid.Column="1" Text="Focus global search bar" />

                            <TextBlock Grid.Row="9" Grid.Column="0" Text="F3 / Shift + F3" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Grid.Row="9" Grid.Column="1" Text="Cycle to Next / Previous search hit in Reader" />

                            <TextBlock Grid.Row="10" Grid.Column="0" Text="Escape" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Grid.Row="10" Grid.Column="1" Text="Exit Focus Mode / Clear search hit highlights" />
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- SECTION 11: FAQ & Troubleshooting -->
                <Expander x:Name="ExpanderFAQ" Style="{StaticResource GuideExpanderStyle}" IsExpanded="False" Tag="faq troubleshooting questions purports lilamrita d artifact backup offline sync">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE9CE;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="11. In-Depth FAQ &amp; Research Troubleshooting" FontWeight="SemiBold" FontSize="14" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Spacing="14" Padding="6,10,6,12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Q: Are full Bhaktivedanta purports included in Focus Mode?" FontWeight="SemiBold" />
                            <TextBlock Text="A: Yes, 100%. In Focus Mode, the entire Bhaktivedanta purport is preserved and rendered with customized typography, comfortable line spacing, and golden citation styling." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Q: Was the stray 'd' artifact in Prabhupāda-līlāmṛta resolved?" FontWeight="SemiBold" />
                            <TextBlock Text="A: Yes. The RTF parser was upgraded to cleanly strip legacy byte control words, rejoining hyphenated words across line boundaries. All 55 chapters of Śrīla Prabhupāda-līlāmṛta have 0 stray artifacts and 100% clean English and Sanskrit diacritics." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Q: How do automatic backups work?" FontWeight="SemiBold" />
                            <TextBlock Text="A: On startup, VedaBase Modern automatically creates rolling .vdbbackup archives of your personal notes, bookmarks, and highlights in your local AppData folder. You can export or restore archives anytime in Settings." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Q: Does the app work completely offline without an internet connection?" FontWeight="SemiBold" />
                            <TextBlock Text="A: Yes! The entire 28,000+ record scripture corpus, Sanskrit dictionary, audio pulse synthesizer, and SQLite full-text search engine run completely offline on your local computer." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Expander>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
