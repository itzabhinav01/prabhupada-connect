<ContentDialog
    x:Class="VedaBaseModern.UI.Views.AdvancedSearchDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:repo="using:VedaBaseModern.Core.Repositories"
    xmlns:local="using:VedaBaseModern.UI.Views"
    mc:Ignorable="d"
    PrimaryButtonText="Search"
    SecondaryButtonText="Apply Query"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    MinWidth="720"
    MaxWidth="1920"
    CornerRadius="12"
    Background="{ThemeResource LayerFillColorDefaultBrush}"
    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
    Foreground="{ThemeResource TextFillColorPrimaryBrush}">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">1920</x:Double>
        <x:Double x:Key="ContentDialogMinWidth">720</x:Double>
    </ContentDialog.Resources>

    <ContentDialog.Title>
        <Grid HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="⚡ Folio Advanced Query &amp; Corpus Word Wheel"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1" x:Name="MaximizeButton" Click="MaximizeButton_Click"
                    Style="{StaticResource TextBlockButtonStyle}" Padding="6"
                    ToolTipService.ToolTip="Maximize / Restore Dialog">
                <FontIcon x:Name="MaximizeIcon" Glyph="&#xE922;" FontSize="14" />
            </Button>
        </Grid>
    </ContentDialog.Title>

    <ScrollViewer x:Name="DialogScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="600" HorizontalAlignment="Stretch">
        <Grid x:Name="DialogRootGrid" Width="740" RowSpacing="14" Margin="0,0,8,0" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="260" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Split: Left Word Wheel, Right Hit Counter & Operator Buttons -->
            <Grid Grid.Row="0" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="330" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: Word Wheel -->
                <Border Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="12">
                    <Grid RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Word:" FontWeight="SemiBold" FontSize="13" />
                        <TextBox Grid.Row="1" x:Name="WordInputBox"
                                 PlaceholderText="Type word to scroll index..."
                                 TextChanged="WordInputBox_TextChanged"
                                 KeyDown="WordInputBox_KeyDown"
                                 FontSize="13" Height="34" />

                        <ListView Grid.Row="2" x:Name="WordWheelListView"
                                  SelectionChanged="WordWheelListView_SelectionChanged"
                                  DoubleTapped="WordWheelListView_DoubleTapped"
                                  ItemsSource="{x:Bind VocabTerms, Mode=OneWay}"
                                  Margin="0,4,0,0">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="repo:VocabTerm">
                                    <Grid ColumnSpacing="8" Padding="2,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind Term}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="{x:Bind DocumentCount}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

            <!-- Right: Records with hits counter & Operator helpers -->
            <Border Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14">
                <StackPanel Spacing="10">
                    <TextBlock Text="Records with hits:" FontWeight="SemiBold" FontSize="13" />

                    <!-- Hit Counter Display Card -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="12,10">
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="SelectedWordHitsText" Text="Select or type a word on the left" FontWeight="Bold" FontSize="14" TextWrapping="Wrap" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="SelectedWordOccurrencesText" Text="0 total occurrences in corpus" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Insert Word Button -->
                    <Button x:Name="InsertWordButton" Click="InsertWordButton_Click" Content="Insert Word into Query ↵" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" Height="34" />

                    <TextBlock Text="Query Operators:" FontWeight="SemiBold" FontSize="12" Margin="0,4,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <!-- Operator Button Grid -->
                    <Grid ColumnSpacing="6" RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Button Grid.Row="0" Grid.Column="0" Content="AND" Click="OperatorButton_Click" Tag=" AND " HorizontalAlignment="Stretch" />
                        <Button Grid.Row="0" Grid.Column="1" Content="OR" Click="OperatorButton_Click" Tag=" OR " HorizontalAlignment="Stretch" />
                        <Button Grid.Row="0" Grid.Column="2" Content="NOT" Click="OperatorButton_Click" Tag=" NOT " HorizontalAlignment="Stretch" />

                        <Button Grid.Row="1" Grid.Column="0" Content="w/5" Click="OperatorButton_Click" Tag=" w/5 " HorizontalAlignment="Stretch" ToolTipService.ToolTip="Words within 5 words of each other" />
                        <Button Grid.Row="1" Grid.Column="1" Content="w/10" Click="OperatorButton_Click" Tag=" w/10 " HorizontalAlignment="Stretch" ToolTipService.ToolTip="Words within 10 words of each other" />
                        <Button Grid.Row="1" Grid.Column="2" Content="[ &quot;Phrase&quot; ]" Click="PhraseButton_Click" HorizontalAlignment="Stretch" ToolTipService.ToolTip="Wrap in exact quotation marks" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Middle: Query Editor & Scope -->
        <Grid Grid.Row="1" RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Query For:" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Scope:" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Name="ScopeComboBox" Width="160" Height="32" FontSize="12">
                        <ComboBoxItem Content="All Fields" IsSelected="True" />
                        <ComboBoxItem Content="Purports Only" />
                        <ComboBoxItem Content="Translations Only" />
                        <ComboBoxItem Content="Synonyms Only" />
                        <ComboBoxItem Content="Devanagari Only" />
                    </ComboBox>
                </StackPanel>
            </Grid>

            <TextBox Grid.Row="1" x:Name="QueryForTextBox"
                     PlaceholderText="Enter keywords, Boolean operators (AND, OR, NOT), or proximity (e.g. krishna w/5 arjuna)..."
                     Height="40" FontSize="14" />

            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4" Margin="0,2,0,0">
                <TextBlock Text="Quick examples:" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                <HyperlinkButton Content="krishna w/5 arjuna" Click="ExampleQuery_Click" Tag="krishna w/5 arjuna" FontSize="11" Padding="4,2" />
                <HyperlinkButton Content="bhakti AND yoga NOT jnana" Click="ExampleQuery_Click" Tag="bhakti AND yoga NOT jnana" FontSize="11" Padding="4,2" />
                <HyperlinkButton Content="&quot;supreme personality of godhead&quot;" Click="ExampleQuery_Click" Tag="&quot;supreme personality of godhead&quot;" FontSize="11" Padding="4,2" />
            </StackPanel>
        </Grid>

        <!-- Bottom: Checked Branches (Multi-Book Checklist) -->
        <Expander Grid.Row="2" x:Name="CheckedBranchesExpander" HorizontalAlignment="Stretch" IsExpanded="False">
            <Expander.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE762;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="Checked Branches (Filter Specific Books)" FontWeight="SemiBold" FontSize="13" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" x:Name="CheckedCountText" Text="All 46 Books Checked" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                </Grid>
            </Expander.Header>
            <Grid Height="200" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Quick Check Actions -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6">
                    <Button Content="Select All" Click="SelectAllBooks_Click" FontSize="11" Padding="8,4" />
                    <Button Content="Clear All" Click="ClearAllBooks_Click" FontSize="11" Padding="8,4" />
                    <Button Content="Scriptures Only" Click="SelectScripturesOnly_Click" FontSize="11" Padding="8,4" />
                    <Button Content="Biographies Only" Click="SelectBiographiesOnly_Click" FontSize="11" Padding="8,4" />
                </StackPanel>

                <!-- Scrollable Book Checkboxes -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsRepeater x:Name="BookChecklistRepeater">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="220" MinRowSpacing="4" MinColumnSpacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="local:BookCheckItem">
                                <CheckBox Content="{x:Bind Title}" IsChecked="{x:Bind IsChecked, Mode=TwoWay}"
                                          Checked="BookCheckBox_Changed" Unchecked="BookCheckBox_Changed"
                                          FontSize="12" Margin="0,2" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>
            </Grid>
        </Expander>
    </Grid>
    </ScrollViewer>
</ContentDialog>
