<Page
    x:Class="VedaBaseModern.UI.Views.NotesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:VedaBaseModern.UI.ViewModels"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Title & Progress -->
        <StackPanel Grid.Row="0" Margin="24,12,24,6" HorizontalAlignment="Stretch">
            <TextBlock Text="Personal Realizations &amp; Notes" Style="{StaticResource TitleTextBlockStyle}" />
            <ProgressBar IsIndeterminate="True"
                         Visibility="{x:Bind BoolToVis(ViewModel.IsLoading), Mode=OneWay}"
                         Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Search + New Note + Export Action Bar -->
        <Grid Grid.Row="1" Margin="24,0,24,10" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox Grid.Column="0" Margin="0,0,10,0"
                            PlaceholderText="Search reflections, tags, verses..."
                            Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            QueryIcon="Find"
                            AutomationProperties.Name="Search notes" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="+ New Note"
                        Command="{x:Bind ViewModel.StartNewNoteCommand}"
                        Style="{StaticResource AccentButtonStyle}" />
                <Button x:Name="ExportObsidianButton" Click="ExportObsidianButton_Click" ToolTipService.ToolTip="Export entire research notebook as an Obsidian-compatible Vault (.zip with YAML frontmatter)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8B7;" FontSize="13" />
                        <TextBlock Text="Obsidian Vault (.zip)" />
                    </StackPanel>
                </Button>
                <Button x:Name="ExportPrintHtmlButton" Click="ExportPrintHtmlButton_Click" ToolTipService.ToolTip="Export styled research document for printing or PDF save">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE749;" FontSize="13" />
                        <TextBlock Text="Print / PDF" />
                    </StackPanel>
                </Button>
                <Button x:Name="ExportAllNotesButton" Click="ExportAllNotesButton_Click" ToolTipService.ToolTip="Export all notes as a single Markdown notebook (.md)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xEDE1;" FontSize="13" />
                        <TextBlock Text="Export Markdown" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.FilteredCountText, Mode=OneWay}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center" HorizontalAlignment="Right" />
        </Grid>

        <!-- Tag Cloud / Topic Taxonomies Horizontal Bar -->
        <ScrollViewer Grid.Row="2" Margin="24,0,24,12" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
            <ItemsControl ItemsSource="{x:Bind ViewModel.AvailableTags, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Button Content="{x:Bind}" Click="TagChipButton_Click"
                                Style="{StaticResource DefaultButtonStyle}" Height="30" Padding="10,2" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Master-Detail Content Area -->
        <Grid Grid.Row="3" Margin="24,0,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" MinWidth="300" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <!-- Left Pane: Notes List -->
            <Grid Grid.Column="0">
                <!-- Empty state -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                            Visibility="{x:Bind ShowEmptyState(ViewModel.IsLoading, ViewModel.Notes.Count), Mode=OneWay}">
                    <TextBlock Text="No notes yet." Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                    <TextBlock Text="Write a note on any verse, or click + New Note." Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                </StackPanel>

                <ListView ItemsSource="{x:Bind ViewModel.FilteredNotes, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedNote, Mode=TwoWay}"
                          SelectionMode="Single"
                          SelectionChanged="NotesList_SelectionChanged"
                          Padding="0,0,12,0">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0,2" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:NoteListItem">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,3"
                                    HorizontalAlignment="Stretch">
                                <Grid RowSpacing="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Title & Scripture Badge -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind TitleDisplay}" FontWeight="SemiBold" FontSize="15" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        <Border Grid.Column="1" Background="{ThemeResource AccentFillColorTertiaryBrush}" CornerRadius="10" Padding="6,2" Margin="6,0,0,0"
                                                Visibility="{x:Bind HasScriptureAssociationVisibility}" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE8A5;" FontSize="10" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                                <TextBlock Text="{x:Bind Reference}" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Clean Preview text -->
                                    <TextBlock Grid.Row="1" Text="{x:Bind PreviewDisplay}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" />

                                    <!-- Tags Badge -->
                                    <TextBlock Grid.Row="2" Text="{x:Bind TagsSummary}" Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                               FontSize="11.5" FontWeight="SemiBold" Visibility="{x:Bind HasTagsVisibility}" TextTrimming="CharacterEllipsis" />

                                    <!-- Metadata Footer -->
                                    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                                        <TextBlock Text="{x:Bind BookTitle}" FontWeight="Medium" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="11.5" />
                                        <TextBlock Text="•" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="11.5" />
                                        <TextBlock Text="{x:Bind UpdatedDisplay}" FontSize="11.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- Vertical Divider -->
            <Border Grid.Column="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,0,16,0" />

            <!-- Right Pane: Side-Pane Rich Note Viewer -->
            <Grid Grid.Column="2" Padding="8,0,0,0">
                <!-- If No note selected -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                            Visibility="{x:Bind NullToVis(ViewModel.SelectedNote), Mode=OneWay}">
                    <FontIcon Glyph="&#xE70F;" FontSize="36" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Select a note to view its details" Style="{StaticResource SubtitleTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- When note selected -->
                <Grid Visibility="{x:Bind NotNullToVis(ViewModel.SelectedNote), Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Detail Header & Action Toolbar -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="{x:Bind ViewModel.SelectedNote.TitleDisplay, Mode=OneWay}"
                                       FontSize="22" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Click="OpenScriptureInNewTab_Click" Style="{StaticResource TextBlockButtonStyle}" Padding="0"
                                        Visibility="{x:Bind ViewModel.SelectedNote.HasScriptureAssociationVisibility, Mode=OneWay}" ToolTipService.ToolTip="Open verse in new tab">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE8A5;" FontSize="12" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.SelectedNote.Reference, Mode=OneWay}" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.SelectedNote.BookTitle, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="•" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="12" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedNote.UpdatedDisplay, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                            <!-- Hashtags -->
                            <TextBlock Text="{x:Bind ViewModel.SelectedNote.TagsSummary, Mode=OneWay}"
                                       Foreground="{ThemeResource AccentFillColorDefaultBrush}" FontWeight="SemiBold" FontSize="12"
                                       Visibility="{x:Bind ViewModel.SelectedNote.HasTagsVisibility, Mode=OneWay}" Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- Action Buttons -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                            <Button Click="EditSelectedNote_Click" Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE70F;" FontSize="12" />
                                    <TextBlock Text="Edit" />
                                </StackPanel>
                            </Button>
                            <Button Click="DeleteSelectedNote_Click" Style="{StaticResource DefaultButtonStyle}">
                                <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,0,0,14" />

                    <!-- Rendered Rich Note Content Body -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="20,16">
                            <TextBlock x:Name="DetailBodyTextBlock" Text="{x:Bind ViewModel.SelectedNote.PreviewDisplay, Mode=OneWay}"
                                       TextWrapping="Wrap" FontSize="15" LineHeight="26"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontFamily="Georgia, Cambria, 'Times New Roman', serif" />
                        </Border>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- Editor Dialog: create or edit a note -->
        <ContentDialog x:Name="NoteEditorDialog"
                       Title="{x:Bind EditorTitle(ViewModel.IsEditingExisting), Mode=OneWay}"
                       PrimaryButtonText="Save" SecondaryButtonText="Delete" CloseButtonText="Cancel"
                       PrimaryButtonClick="NoteEditorDialog_PrimaryButtonClick"
                       SecondaryButtonClick="NoteEditorDialog_SecondaryButtonClick"
                       IsSecondaryButtonEnabled="{x:Bind ViewModel.IsEditingExisting, Mode=OneWay}"
                       DefaultButton="Primary">
            <ScrollViewer MaxHeight="480" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="12" Width="440">
                    <TextBlock Text="{x:Bind ViewModel.EditorErrorMessage, Mode=OneWay}"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               TextWrapping="Wrap"
                               Visibility="{x:Bind HasText(ViewModel.EditorErrorMessage), Mode=OneWay}" />

                    <TextBox Header="Title" PlaceholderText="e.g. Reflections on surrender (#surrender)"
                             Text="{x:Bind ViewModel.EditTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBox Header="Note Content" PlaceholderText="Write your note here... (support for #hashtags and [[WikiLinks]])"
                             Text="{x:Bind ViewModel.EditContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" Height="180" />

                    <TextBlock Text="💡 Type #tags (e.g. #surrender, #guru-tattva) to categorize, or [[Note Title]] / [[BG 4.9]] to link."
                               FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

                    <StackPanel Spacing="2" Visibility="{x:Bind ViewModel.EditHasSource, Mode=OneWay}">
                        <TextBlock Text="Source" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                        <TextBlock Text="{x:Bind ViewModel.EditSourceBookTitle, Mode=OneWay}" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind ViewModel.EditSourceReference, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.EditField, Mode=OneWay}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="12" />
                        <HyperlinkButton Content="Open in Reading View" Padding="0,4,0,0"
                                         Click="OpenInReadingView_Click" />
                    </StackPanel>
                    <TextBlock Text="General research note (no scripture association)"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="12"
                               Visibility="{x:Bind Not(ViewModel.EditHasSource), Mode=OneWay}" />
                </StackPanel>
            </ScrollViewer>
        </ContentDialog>
    </Grid>
</Page>
