<Page
    x:Class="VedaBaseModern.UI.Views.BookmarksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:VedaBaseModern.UI.ViewModels"
    xmlns:models="using:VedaBaseModern.Core.Models"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header: title + New Collection -->
        <Grid Grid.Row="0" Margin="0,0,0,20" MaxWidth="1150" HorizontalAlignment="Center" Padding="24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Bookmarks" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <Button Grid.Column="1" x:Name="NewCollectionButton" VerticalAlignment="Center"
                    Click="NewCollectionButton_Click"
                    ToolTipService.ToolTip="Create a new bookmark collection"
                    AutomationProperties.Name="New collection">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock Text="New Collection" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Phase 4.9.1: collection filter - a single compact picker replaces
             rendering every collection as its own giant section. Selecting a
             collection only changes which bookmarks are SHOWN (FilteredItems,
             computed client-side in the ViewModel); it never mutates a
             bookmark's actual CollectionId. Rename/Delete for the collection
             currently being viewed sit right next to the picker instead of a
             separate management surface, and only show once a real (non-All,
             non-Uncategorized) collection is selected. -->
        <Grid Grid.Row="1" Margin="0,0,0,16" MaxWidth="1150" HorizontalAlignment="Center" Padding="24,0"
              Visibility="{x:Bind BoolToVis(ViewModel.HasAnyBookmarksOrCollections), Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0" x:Name="FilterComboBox"
                      ItemsSource="{x:Bind ViewModel.FilterOptions, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedFilter, Mode=TwoWay}"
                      MinWidth="200"
                      AutomationProperties.Name="Filter bookmarks by collection">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:CollectionFilterOption">
                        <TextBlock Text="{x:Bind Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="4,0,0,0" VerticalAlignment="Center"
                        Visibility="{x:Bind IsRealCollectionVis(ViewModel.SelectedFilter), Mode=OneWay}">
                <Button Style="{StaticResource TextBlockButtonStyle}" Click="RenameSelectedCollection_Click"
                        ToolTipService.ToolTip="Rename this collection" AutomationProperties.Name="Rename collection">
                    <FontIcon Glyph="&#xE70F;" FontSize="14" />
                </Button>
                <Button Style="{StaticResource TextBlockButtonStyle}" Click="DeleteSelectedCollection_Click"
                        ToolTipService.ToolTip="Delete this collection (bookmarks are kept, uncategorized)" AutomationProperties.Name="Delete collection">
                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                </Button>
            </StackPanel>
            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.FilteredCountText, Mode=OneWay}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center" HorizontalAlignment="Right" />
        </Grid>

        <!-- No bookmarks and no collections at all yet. -->
        <StackPanel Grid.Row="2" MaxWidth="1150" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Spacing="8"
                    Visibility="{x:Bind ShowEmptyState(ViewModel.IsLoading, ViewModel.HasAnyBookmarksOrCollections), Mode=OneWay}">
            <TextBlock Text="No bookmarks yet." Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
            <TextBlock Text="Bookmark a passage in Reading View to find it here."
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
        </StackPanel>

        <Grid Grid.Row="2" Visibility="{x:Bind ViewModel.HasAnyBookmarksOrCollections, Mode=OneWay}">
            <!-- Compact empty state for the currently selected filter (e.g. a
                 freshly created or otherwise empty collection) - never a huge
                 blank section, just a short centered message. -->
            <StackPanel MaxWidth="1150" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4"
                        Visibility="{x:Bind BoolToVis(ViewModel.IsFilterEmpty), Mode=OneWay}">
                <TextBlock Text="{x:Bind ViewModel.FilterEmptyMessage, Mode=OneWay}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <ScrollViewer Visibility="{x:Bind InverseBoolToVis(ViewModel.IsFilterEmpty), Mode=OneWay}">
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.FilteredItems, Mode=OneWay}" MaxWidth="1150" HorizontalAlignment="Center" Margin="24,0,24,24">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="8" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:BookmarkItem">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="16,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Click="OpenBookmark_Click" Tag="{x:Bind RecordKey}"
                                            Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                        <StackPanel>
                                            <TextBlock Text="{x:Bind BookTitle}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="12" />
                                            <TextBlock Text="{x:Bind Reference}" FontWeight="Bold" FontSize="15" Margin="0,2,0,2" />
                                            <TextBlock Text="{x:Bind Preview}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1" Tag="{x:Bind}" VerticalAlignment="Center"
                                            Style="{StaticResource TextBlockButtonStyle}"
                                            ToolTipService.ToolTip="Bookmark actions" AutomationProperties.Name="Bookmark actions">
                                        <FontIcon Glyph="&#xE712;" FontSize="14" />
                                        <Button.Flyout>
                                            <MenuFlyout Opening="BookmarkActionsFlyout_Opening">
                                                <MenuFlyoutSubItem x:Name="MoveToSubItem" Text="Move to..." Tag="{x:Bind}" />
                                                <MenuFlyoutItem x:Name="RemoveFromCollectionItem" Text="Remove from collection" Click="RemoveFromCollection_Click" Tag="{x:Bind}" />
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem Text="Delete Bookmark" Click="RemoveBookmark_Click" Tag="{x:Bind RecordKey}" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
