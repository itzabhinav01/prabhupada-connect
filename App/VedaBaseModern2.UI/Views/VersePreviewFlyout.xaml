<Flyout
    x:Class="VedaBaseModern.UI.Views.VersePreviewFlyout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Width="380" MaxHeight="320" RowSpacing="8" Padding="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock x:Name="ReferenceText" FontWeight="Bold" FontSize="15" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
            <TextBlock x:Name="BookTitleText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="6">
                <TextBlock x:Name="TranslitText" FontStyle="Italic" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="TranslationText" TextWrapping="Wrap" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            </StackPanel>
        </ScrollViewer>

        <!-- Action Button -->
        <Button Grid.Row="2" x:Name="OpenVerseButton" Content="Open in Reading View"
                Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="OpenVerseButton_Click" />
    </Grid>
</Flyout>
