<ContentDialog
    x:Class="VedaBaseModern.UI.Views.ConcordanceDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:VedaBaseModern.Core.Models"
    mc:Ignorable="d"
    Title="Sanskrit Lemma &amp; Grammatical Word Explorer"
    CloseButtonText="Close"
    DefaultButton="Close"
    CornerRadius="14"
    MinWidth="750"
    MaxWidth="920"
    Background="{ThemeResource LayerFillColorDefaultBrush}"
    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
    Foreground="{ThemeResource TextFillColorPrimaryBrush}">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">920</x:Double>
        <x:Double x:Key="ContentDialogMinWidth">750</x:Double>
    </ContentDialog.Resources>

    <Grid Width="780" MaxWidth="850" Height="560" RowSpacing="8" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Search / Word Input Header -->
        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox x:Name="WordInputBox" PlaceholderText="Explore Sanskrit lemma, root, or grammatical form (e.g. prapadyate, bhakti, dharma)..."
                            QueryIcon="Find" QuerySubmitted="WordInputBox_QuerySubmitted" Height="38" FontSize="14" />
            <Button Grid.Column="1" Content="Explore Lemma" Click="LookupButton_Click" Style="{StaticResource AccentButtonStyle}" Height="38" />
        </Grid>

        <!-- Lexicon Card (Lemma, Primary Root Gloss, Grammatical Context & Frequency) -->
        <Border Grid.Row="1" x:Name="LexiconCard"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="10" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock x:Name="LemmaTitleText" Text="Lemma:" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="WordTermText" Text="" FontWeight="Bold" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                        <Border Background="{ThemeResource AccentFillColorTertiaryBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock x:Name="GrammarBadgeText" Text="Sanskrit Lemma" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="LexiconGlossText" Text="Select a Sanskrit word to explore its root meaning and scriptural usage."
                               FontStyle="Italic" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:Name="CountBadgeText" Text="0 occurrences" FontWeight="Bold" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Right" />
                    <TextBlock Text="across all 40 books" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" />
                    <ProgressRing x:Name="LoadingRing" Width="16" Height="16" IsActive="False" Visibility="Collapsed" HorizontalAlignment="Right" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Book Frequency Distribution Chips -->
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
            <StackPanel x:Name="BookChipsPanel" Orientation="Horizontal" Spacing="6" Padding="0,2" />
        </ScrollViewer>

        <!-- In-dialog Fast Filter for Researchers -->
        <TextBox Grid.Row="3" x:Name="QuickFilterBox"
                 PlaceholderText="Filter results (e.g. 10.14, compassion, therefore)..."
                 TextChanged="QuickFilterBox_TextChanged"
                 Height="34" FontSize="13" Margin="0,2,0,2" />

        <!-- Matches List -->
        <ListView Grid.Row="4" x:Name="MatchesListView"
                  SelectionMode="None" IsItemClickEnabled="True" ItemClick="MatchesListView_ItemClick"
                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="6">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:ConcordanceMatch">
                    <Grid Padding="12,10" Margin="0,3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" RowSpacing="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Verse Reference & Book Title -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Bind Reference}" FontWeight="Bold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" FontSize="14" />
                            <TextBlock Text="{x:Bind BookTitle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Field Badge -->
                        <Border Grid.Row="0" Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="4" Padding="6,2">
                            <TextBlock Text="{x:Bind Field}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </Border>

                        <!-- Snippet or Synonym Pair -->
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{x:Bind Snippet}" TextWrapping="Wrap" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Margin="0,2,0,0" />

                        <!-- Gloss definition if available -->
                        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{x:Bind Gloss}" FontStyle="Italic" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</ContentDialog>
