<Page
    x:Class="VedaBaseModern.UI.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:VedaBaseModern.UI.ViewModels"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer>
        <StackPanel MaxWidth="700" HorizontalAlignment="Stretch" Margin="0,0,0,48" Spacing="4">

            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,4" />
            <TextBlock Text="Customize the reading experience. These preferences are stored on this device only."
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,24" />

            <InfoBar IsOpen="True" Severity="Error" Title="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                     Visibility="{x:Bind StringToVis(ViewModel.ErrorMessage), Mode=OneWay}" Margin="0,0,0,16" />

            <!-- Help & Documentation Banner -->
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE897;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock Text="Documentation &amp; User Manual" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="16" />
                        </StackPanel>
                        <TextBlock Text="Learn how to use Zen Focus mode, Split View, Sanskrit Chanting guides, Folio Advanced Search, Notes sync, and keyboard shortcuts."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" FontSize="13" />
                    </StackPanel>
                    <Button Grid.Column="1" Click="OpenUserGuide_Click" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center" Margin="16,0,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE897;" FontSize="14" />
                            <TextBlock Text="Open User Manual (F1)" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Appearance -->
            <TextBlock Text="Appearance" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,8" />
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="20" Margin="0,0,0,24">
                <StackPanel Spacing="16">
                    <RadioButtons Header="Theme" SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                        <RadioButton Content="System" />
                        <RadioButton Content="Light" />
                        <RadioButton Content="Dark" />
                        <RadioButton Content="Custom" />
                    </RadioButtons>

                    <!-- Custom Theme Panel (Visible when Custom is selected) -->
                    <StackPanel Visibility="{x:Bind BoolToVis(ViewModel.IsCustomThemeSelected), Mode=OneWay}"
                                Spacing="14" Margin="0,8,0,0">
                        <MenuFlyoutSeparator />

                        <!-- Curated Preset Dropdown -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Curated Reading Preset" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ComboBox ItemsSource="{x:Bind ViewModel.CuratedPresetNames}"
                                      SelectedItem="{x:Bind ViewModel.SelectedPresetName, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <!-- Collapsible Palette Designer for advanced custom styling -->
                        <Expander IsExpanded="False" HorizontalAlignment="Stretch">
                            <Expander.Header>
                                <StackPanel Spacing="2" Margin="0,6,0,6">
                                    <TextBlock Text="Palette Designer &amp; Custom Colors" FontWeight="SemiBold" />
                                    <TextBlock Text="Fine-tune individual colors, opacity, and base contrast"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel Spacing="16" Margin="0,10,0,0">
                                <!-- Clone Buttons -->
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                    <Button Command="{x:Bind ViewModel.CopyFromDarkCommand}" ToolTipService.ToolTip="Clone standard Dark theme colors into custom theme">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE708;" FontSize="13" />
                                            <TextBlock Text="Copy from Dark" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{x:Bind ViewModel.CopyFromLightCommand}" ToolTipService.ToolTip="Clone standard Light theme colors into custom theme">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE706;" FontSize="13" />
                                            <TextBlock Text="Copy from Light" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <!-- Interactive Live Preview Card -->
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Live Preview (Scripture Card)" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Border Background="{x:Bind ViewModel.PreviewPageBackgroundBrush, Mode=OneWay}"
                                            BorderBrush="{x:Bind ViewModel.PreviewDividerBrush, Mode=OneWay}"
                                            BorderThickness="1" CornerRadius="8" Padding="16">
                                        <StackPanel Spacing="12">
                                            <!-- Mini Navigation Header -->
                                            <Border Background="{x:Bind ViewModel.PreviewNavPaneBrush, Mode=OneWay}"
                                                    BorderBrush="{x:Bind ViewModel.PreviewDividerBrush, Mode=OneWay}"
                                                    BorderThickness="1" CornerRadius="6" Padding="12,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="📖" VerticalAlignment="Center" FontSize="13" />
                                                        <TextBlock Text="Bhagavad-gītā 9.6" FontWeight="SemiBold" FontSize="13"
                                                                   Foreground="{x:Bind ViewModel.PreviewAccentBrush, Mode=OneWay}" VerticalAlignment="Center" />
                                                        <TextBlock Text="— The Most Confidential Knowledge" FontSize="12"
                                                                   Foreground="{x:Bind ViewModel.PreviewSecondaryTextBrush, Mode=OneWay}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Background="{x:Bind ViewModel.PreviewAccentBrush, Mode=OneWay}"
                                                            CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="BG 9.6" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <!-- Scripture Verse Card -->
                                            <Border Background="{x:Bind ViewModel.PreviewCardBackgroundBrush, Mode=OneWay}"
                                                    BorderBrush="{x:Bind ViewModel.PreviewDividerBrush, Mode=OneWay}"
                                                    BorderThickness="1" CornerRadius="8" Padding="16">
                                                <StackPanel Spacing="10">
                                                    <!-- Sanskrit Verse -->
                                                    <TextBlock Text="yathākāśa-sthito nityaṁ vāyuḥ sarvatra-go mahān&#x0a;tathā sarvāṇi bhūtāni mat-sthānīty upadhāraya"
                                                               Foreground="{x:Bind ViewModel.PreviewAccentBrush, Mode=OneWay}"
                                                               FontStyle="Italic"
                                                               HorizontalAlignment="Center"
                                                               TextAlignment="Center"
                                                               FontSize="13"
                                                               LineHeight="18" />

                                                    <Rectangle Height="1" Fill="{x:Bind ViewModel.PreviewDividerBrush, Mode=OneWay}" Margin="0,2" />

                                                    <!-- Speaker Dialogue Turn -->
                                                    <StackPanel Spacing="6">
                                                        <TextBlock TextWrapping="Wrap" FontSize="12"
                                                                   Foreground="{x:Bind ViewModel.PreviewPrimaryTextBrush, Mode=OneWay}">
                                                            <Run FontWeight="Bold" Text="Śrīla Prabhupāda: " />
                                                            <Run Text="Understand that as the mighty wind, blowing everywhere, rests always in the sky, all created beings rest in Me." />
                                                        </TextBlock>
                                                        <TextBlock Text="All material cosmic operations are conducted by the supreme will of the Lord."
                                                                   TextWrapping="Wrap" FontSize="12"
                                                                   Foreground="{x:Bind ViewModel.PreviewSecondaryTextBrush, Mode=OneWay}" />
                                                    </StackPanel>

                                                    <!-- Action Buttons & Tags -->
                                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                                                        <Border BorderBrush="{x:Bind ViewModel.PreviewAccentBrush, Mode=OneWay}"
                                                                BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                            <TextBlock Text="Citation: BG 9.6" FontSize="10" Foreground="{x:Bind ViewModel.PreviewAccentBrush, Mode=OneWay}" />
                                                        </Border>
                                                        <Border BorderBrush="{x:Bind ViewModel.PreviewDividerBrush, Mode=OneWay}"
                                                                BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                            <TextBlock Text="Bookmark" FontSize="10" Foreground="{x:Bind ViewModel.PreviewSecondaryTextBrush, Mode=OneWay}" />
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Component Selector & Color Editor -->
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="14">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Component to Customize" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <ComboBox SelectedIndex="{x:Bind ViewModel.SelectedComponentIndex, Mode=TwoWay}"
                                                      HorizontalAlignment="Stretch">
                                                <ComboBoxItem Content="Canvas / Page Background" />
                                                <ComboBoxItem Content="Cards &amp; Surfaces" />
                                                <ComboBoxItem Content="Navigation Pane Background" />
                                                <ComboBoxItem Content="Primary Text" />
                                                <ComboBoxItem Content="Secondary Text" />
                                                <ComboBoxItem Content="Accent / Saffron Gold" />
                                                <ComboBoxItem Content="Borders &amp; Dividers" />
                                            </ComboBox>
                                        </StackPanel>

                                        <!-- Direct Hex Input & Swatch -->
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Color Hex Code &amp; Alpha Opacity" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border Width="34" Height="34" CornerRadius="4" BorderThickness="1"
                                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                        Background="{x:Bind ViewModel.CurrentComponentBrush, Mode=OneWay}" />
                                                <TextBox Text="{x:Bind ViewModel.HexCodeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Width="180" VerticalAlignment="Center" PlaceholderText="#FF0F281E" />
                                            </StackPanel>
                                            <TextBlock Text="Format: #RRGGBB or #AARRGGBB with transparency"
                                                       FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>

                                        <!-- Base Contrast Switcher -->
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Base Theme Contrast" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <RadioButtons SelectedIndex="{x:Bind ViewModel.BaseThemeIndex, Mode=TwoWay}">
                                                <RadioButton Content="Dark Mode Base (Light text on dark components)" />
                                                <RadioButton Content="Light Mode Base (Dark text on bright components)" />
                                            </RadioButtons>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- ColorPicker with Spectrum, RGB/HSV, Alpha (Opacity), and Hex -->
                                    <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1" CornerRadius="8" Padding="14">
                                        <ColorPicker Color="{x:Bind ViewModel.PickerColor, Mode=TwoWay}"
                                                     IsColorSpectrumVisible="True"
                                                     IsColorSliderVisible="True"
                                                     IsAlphaSliderVisible="True"
                                                     IsHexInputVisible="True" />
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Expander>

                        <MenuFlyoutSeparator />

                        <!-- Action Bar -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <Button Content="Apply Custom Theme to App" Style="{StaticResource AccentButtonStyle}"
                                        Command="{x:Bind ViewModel.ApplyCustomThemeCommand}" />
                                <Button Content="Reset Custom Theme"
                                        Command="{x:Bind ViewModel.ResetCustomThemeCommand}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CustomThemeStatusMessage, Mode=OneWay}"
                                       Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center"
                                       FontWeight="SemiBold" FontSize="12" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Reading -->
            <TextBlock Text="Reading" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,8" />
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="20" Margin="0,0,0,12">
                <StackPanel Spacing="20">
                    <RadioButtons Header="Font size" SelectedIndex="{x:Bind ViewModel.FontSizeIndex, Mode=TwoWay}">
                        <RadioButton Content="Small" />
                        <RadioButton Content="Medium" />
                        <RadioButton Content="Large" />
                        <RadioButton Content="Extra Large" />
                    </RadioButtons>

                    <MenuFlyoutSeparator />

                    <RadioButtons Header="Reading width" SelectedIndex="{x:Bind ViewModel.ReadingWidthIndex, Mode=TwoWay}">
                        <RadioButton Content="Narrow" />
                        <RadioButton Content="Comfortable" />
                        <RadioButton Content="Wide" />
                    </RadioButtons>

                    <MenuFlyoutSeparator />

                    <RadioButtons Header="Line spacing" SelectedIndex="{x:Bind ViewModel.LineSpacingIndex, Mode=TwoWay}">
                        <RadioButton Content="Compact" />
                        <RadioButton Content="Comfortable" />
                        <RadioButton Content="Relaxed" />
                    </RadioButtons>
                </StackPanel>
            </Border>

            <!-- Text Brightness (Night Reading / Dark Mode) -->
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="20" Margin="0,0,0,12">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Text Brightness (Night Reading)" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="Reduces pure-white glare when reading in dark mode by softening text into gentle greyish tones, relieving eye strain."
                                   TextWrapping="Wrap" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <!-- Quick Preset RadioButtons -->
                    <RadioButtons Header="Preset Contrast" SelectedIndex="{x:Bind ViewModel.TextBrightnessPresetIndex, Mode=TwoWay}">
                        <RadioButton Content="100% — Crisp White (Standard Daylight)" />
                        <RadioButton Content="85% — Soft White (Recommended for Night)" />
                        <RadioButton Content="70% — Muted Grey (Gentle / Dim Room)" />
                        <RadioButton Content="55% — Subdued Grey (Bedtime / Ultra-low Glare)" />
                    </RadioButtons>

                    <!-- Fine-Tuning Slider -->
                    <StackPanel Spacing="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Fine-tune Brightness" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TextBrightnessDisplay, Mode=OneWay}"
                                       FontWeight="SemiBold" FontSize="12"
                                       Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                        </Grid>
                        <Slider Minimum="50" Maximum="100" StepFrequency="5"
                                Value="{x:Bind ViewModel.TextBrightness, Mode=TwoWay}"
                                AutomationProperties.Name="Text Brightness Slider" />
                    </StackPanel>

                    <!-- Live Sample Preview Card -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="14">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Live Preview" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="Śrīla Prabhupāda: &quot;Understand that as the mighty wind, blowing everywhere, rests always in the sky, all created beings rest in Me.&quot;"
                                       FontSize="14" FontFamily="Georgia" TextWrapping="Wrap"
                                       Foreground="{x:Bind ViewModel.ReadingBrightnessSampleBrush, Mode=OneWay}" />
                            <TextBlock Text="Active in Dark Mode and dark custom themes to protect eyes at night."
                                       FontSize="11" FontStyle="Italic"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="20" Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="Start Reading View in Focus Mode" />
                        <TextBlock Text="Focus Mode hides the navigation pane and back button for distraction-free reading. Toggle it any time in Reading View with Ctrl+Shift+F."
                                   TextWrapping="Wrap" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.FocusModeDefault, Mode=TwoWay}"
                                  OnContent="" OffContent="" VerticalAlignment="Center"
                                  AutomationProperties.Name="Start Reading View in Focus Mode" />
                </Grid>
            </Border>

            <!-- Verse Content Sections -->
            <TextBlock Text="Verse Content" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,8" />
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="20" Margin="0,0,0,24">
                <StackPanel Spacing="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Show transliteration" VerticalAlignment="Center" />
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.ShowTransliteration, Mode=TwoWay}"
                                      OnContent="" OffContent="" VerticalAlignment="Center"
                                      AutomationProperties.Name="Show transliteration" />
                    </Grid>
                    <MenuFlyoutSeparator />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Show synonyms (word-for-word)" VerticalAlignment="Center" />
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.ShowSynonyms, Mode=TwoWay}"
                                      OnContent="" OffContent="" VerticalAlignment="Center"
                                      AutomationProperties.Name="Show synonyms" />
                    </Grid>
                    <MenuFlyoutSeparator />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Show purport" VerticalAlignment="Center" />
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.ShowPurport, Mode=TwoWay}"
                                      OnContent="" OffContent="" VerticalAlignment="Center"
                                      AutomationProperties.Name="Show purport" />
                    </Grid>
                    <MenuFlyoutSeparator />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Show pronunciation &amp; recitation guide (Sanskrit meter)" VerticalAlignment="Center" />
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.ShowPronunciationGuide, Mode=TwoWay}"
                                      OnContent="" OffContent="" VerticalAlignment="Center"
                                      AutomationProperties.Name="Show pronunciation and recitation guide" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Highlighting Colours -->
            <TextBlock Text="Highlighting Colours" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,8" />
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="20" Margin="0,0,0,24">
                <StackPanel Spacing="16">
                    <TextBlock Text="Customize highlighting colors or add more colors. Color names follow the standard nomenclature (Colour 1, Colour 2, etc.) and updating a color immediately updates all highlights across your library."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" FontSize="13" />

                    <ItemsControl ItemsSource="{x:Bind ViewModel.HighlightPaletteItems, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:HighlightColorItemViewModel">
                                <Grid Margin="0,6,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Fixed Name (Colour 1, Colour 2...) -->
                                    <TextBlock Grid.Column="0" Text="{x:Bind Name, Mode=OneWay}"
                                               FontWeight="SemiBold" VerticalAlignment="Center" />

                                    <!-- DropDownButton with ColorPicker -->
                                    <DropDownButton Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0" Padding="6,4">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Width="22" Height="22" CornerRadius="4"
                                                    Background="{x:Bind Brush, Mode=OneWay}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1" />
                                            <FontIcon Glyph="&#xE790;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <DropDownButton.Flyout>
                                            <Flyout Placement="BottomEdgeAlignedLeft">
                                                <StackPanel Spacing="8" Width="260">
                                                    <ColorPicker Color="{x:Bind Color, Mode=OneWay}"
                                                                 ColorChanged="HighlightColorPicker_ColorChanged"
                                                                 IsAlphaSliderVisible="False"
                                                                 IsColorSpectrumVisible="True"
                                                                 IsColorSliderVisible="True"
                                                                 IsHexInputVisible="False"
                                                                 Tag="{x:Bind}" />
                                                </StackPanel>
                                            </Flyout>
                                        </DropDownButton.Flyout>
                                    </DropDownButton>

                                    <!-- Hex Code TextBox -->
                                    <TextBox Grid.Column="2"
                                             Text="{x:Bind HexColor, Mode=OneWay}"
                                             PlaceholderText="#RRGGBB"
                                             MaxLength="9"
                                             FontFamily="Consolas, Cascadia Code, monospace"
                                             VerticalAlignment="Center"
                                             LostFocus="HighlightHexTextBox_LostFocus"
                                             KeyDown="HighlightHexTextBox_KeyDown"
                                             Tag="{x:Bind}" />

                                    <!-- Live Preview Pill -->
                                    <Border Grid.Column="3" HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Margin="16,0,0,0" Padding="12,4" CornerRadius="4"
                                            Background="{x:Bind Brush, Mode=OneWay}">
                                        <TextBlock Text="Sample Highlight" FontSize="12" FontWeight="Medium" Foreground="Black" />
                                    </Border>

                                    <!-- Delete Button -->
                                    <Button Grid.Column="4"
                                            Click="RemoveHighlightColour_Click"
                                            Tag="{x:Bind}"
                                            Visibility="{x:Bind CanRemoveVisibility, Mode=OneWay}"
                                            ToolTipService.ToolTip="Remove this colour"
                                            Background="Transparent" BorderThickness="0" Padding="6">
                                        <FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                        <Button Click="AddHighlightColour_Click" Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="14" />
                                <TextBlock Text="Add Colour" />
                            </StackPanel>
                        </Button>

                        <Button Click="ResetHighlightPalette_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE777;" FontSize="14" />
                                <TextBlock Text="Reset Highlighting Colours" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Data & Backup -->
            <TextBlock Text="Data &amp; Backup" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,8" />
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="20" Margin="0,0,0,24">
                <StackPanel Spacing="16">
                    <TextBlock Text="Export or restore your personal research library (bookmarks, collections, highlights, notes, and reading history). Backups are self-contained archives stored locally on your machine."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" FontSize="13" />

                    <!-- Feedback InfoBars for Backup operations -->
                    <InfoBar IsOpen="True" Severity="Success" Title="Backup"
                             Message="{x:Bind ViewModel.BackupStatusMessage, Mode=OneWay}"
                             Visibility="{x:Bind StringToVis(ViewModel.BackupStatusMessage), Mode=OneWay}" />
                    <InfoBar IsOpen="True" Severity="Error" Title="Backup Error"
                             Message="{x:Bind ViewModel.BackupErrorMessage, Mode=OneWay}"
                             Visibility="{x:Bind StringToVis(ViewModel.BackupErrorMessage), Mode=OneWay}" />

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="ExportBackupButton" Click="ExportBackupButton_Click" Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE896;" FontSize="14" />
                                <TextBlock Text="Export Backup Archive" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="RestoreBackupButton" Click="RestoreBackupButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE898;" FontSize="14" />
                                <TextBlock Text="Restore / Import Backup..." />
                            </StackPanel>
                        </Button>

                        <Button x:Name="CreateSnapshotButton" Click="CreateSnapshotButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE7B8;" FontSize="14" />
                                <TextBlock Text="Create Safety Snapshot" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <ProgressBar IsIndeterminate="True"
                                 Visibility="{x:Bind BoolToVis(ViewModel.IsBackupOperationRunning), Mode=OneWay}"
                                 Margin="0,4,0,0" />

                    <MenuFlyoutSeparator />

                    <StackPanel Spacing="2">
                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            <Run Text="Last backup: " />
                            <Run Text="{x:Bind ViewModel.LastBackupDisplay, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap">
                            <Run Text="Backup location: " />
                            <Run Text="{x:Bind ViewModel.BackupLocationDisplay, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Cloud Sync (Optional) -->
            <TextBlock Text="Cloud Sync (Optional)" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,8" />
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="20" Margin="0,0,0,24">
                <StackPanel Spacing="16">
                    <TextBlock Text="Synchronize your personal research data (highlights, notes, bookmarks, and collections) across your devices using your personal Supabase project. Cloud sync is optional; all data is always preserved in your local SQLite database."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" FontSize="13" />

                    <!-- Feedback InfoBars for Cloud Sync operations -->
                    <InfoBar IsOpen="True" Severity="Success" Title="Sync Status"
                             Message="{x:Bind ViewModel.CloudSyncStatusMessage, Mode=OneWay}"
                             Visibility="{x:Bind StringToVis(ViewModel.CloudSyncStatusMessage), Mode=OneWay}" />
                    <InfoBar IsOpen="True" Severity="Error" Title="Sync Error"
                             Message="{x:Bind ViewModel.CloudSyncErrorMessage, Mode=OneWay}"
                             Visibility="{x:Bind StringToVis(ViewModel.CloudSyncErrorMessage), Mode=OneWay}" />

                    <!-- Connected State Panel -->
                    <StackPanel Spacing="8" Visibility="{x:Bind BoolToVis(ViewModel.IsCloudSyncConfigured), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                    BorderBrush="{ThemeResource SystemFillColorSuccessBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="Connected" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                            </Border>
                            <TextBlock Text="{x:Bind ViewModel.SupabaseProjectUrlDisplay, Mode=OneWay}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" FontSize="12" />
                            <TextBlock Text="•" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.UserEmailDisplay, Mode=OneWay}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       VerticalAlignment="Center" FontSize="12" />
                        </StackPanel>

                        <TextBlock Text="{x:Bind ViewModel.SyncStateDisplay, Mode=OneWay}"
                                   FontSize="13" FontWeight="SemiBold" />

                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            <Run Text="Last synced: " />
                            <Run Text="{x:Bind ViewModel.LastSyncDisplay, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>

                        <TextBlock Text="{x:Bind ViewModel.PendingChangesDisplay, Mode=OneWay}"
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <TextBlock Text="{x:Bind ViewModel.SyncStatsDisplay, Mode=OneWay}"
                                   FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,4" VerticalAlignment="Center">
                            <TextBlock Text="Sync Interval:" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ComboBox SelectedIndex="{x:Bind ViewModel.SyncIntervalIndex, Mode=TwoWay}" Width="160">
                                <ComboBoxItem Content="Manual Only" />
                                <ComboBoxItem Content="Every 15 min" />
                                <ComboBoxItem Content="Every 30 min" />
                                <ComboBoxItem Content="Every 1 hour" />
                                <ComboBoxItem Content="Every 6 hours" />
                                <ComboBoxItem Content="Daily" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                            <Button x:Name="SyncNowButton" Click="SyncNowButton_Click" Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE895;" FontSize="14" />
                                    <TextBlock Text="Sync Now" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="ChangeCredentialsButton" Click="ConnectSupabaseButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE70F;" FontSize="14" />
                                    <TextBlock Text="Change Credentials..." />
                                </StackPanel>
                            </Button>

                            <Button x:Name="DisconnectSupabaseButton" Click="DisconnectSupabaseButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xEB9E;" FontSize="14" />
                                    <TextBlock Text="Disconnect..." />
                                </StackPanel>
                            </Button>

                            <Button x:Name="ExportDiagnosticsButton" Click="ExportDiagnosticsButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE9D9;" FontSize="14" />
                                    <TextBlock Text="Export Sync Diagnostics..." />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <TextBlock Text="{x:Bind ViewModel.DiagnosticsStatusMessage, Mode=OneWay}"
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Visibility="{x:Bind StringToVis(ViewModel.DiagnosticsStatusMessage), Mode=OneWay}" />
                    </StackPanel>

                    <!-- Disconnected State Panel -->
                    <StackPanel Spacing="12" Visibility="{x:Bind BoolToInvertedVis(ViewModel.IsCloudSyncConfigured), Mode=OneWay}">
                        <TextBlock Text="{x:Bind ViewModel.SyncStateDisplay, Mode=OneWay}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" />

                        <Button x:Name="ConnectSupabaseButton" Click="ConnectSupabaseButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE753;" FontSize="14" />
                                <TextBlock Text="Connect Supabase Project..." />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <ProgressBar IsIndeterminate="True"
                                 Visibility="{x:Bind BoolToVis(ViewModel.IsSyncing), Mode=OneWay}"
                                 Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Corpus & Book Management -->
            <TextBlock Text="Corpus &amp; Book Management" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,8" />
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="20" Margin="0,0,0,16">
                <StackPanel Spacing="16">
                    <TextBlock Text="Add new books, lectures, or commentaries directly from PDF files or JSON archives. You can also organize books into custom folders or remove imported books."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" TextWrapping="Wrap" />

                    <!-- Ingestion Buttons -->
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Click="ImportPdfSettings_Click" Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xEA90;" FontSize="14" />
                                <TextBlock Text="Import PDF Book Directly..." />
                            </StackPanel>
                        </Button>
                        <Button Click="ImportBookSettings_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                <TextBlock Text="Import Book from JSON..." />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <TextBlock x:Name="BookImportStatusText" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Visibility="Collapsed" TextWrapping="Wrap" />

                    <MenuFlyoutSeparator />

                    <!-- Imported Books List & Removal -->
                    <StackPanel Spacing="10">
                        <TextBlock Text="Imported Books in Library" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="Books and PDFs imported by the user can be removed at any time. Canonical Prabhupāda scriptures are permanently preserved and protected."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />

                        <TextBlock x:Name="NoImportedBooksText" Text="No imported books currently in the library."
                                   FontStyle="Italic" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="0,4,0,0" />

                        <ListView x:Name="ImportedBooksListView" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,4,0,4">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Format Icon -->
                                            <FontIcon Grid.Column="0" Glyph="{Binding IconGlyph}" FontSize="20"
                                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />

                                            <!-- Title & Author -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" />
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{Binding Author}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Text="•" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                    <TextBlock Text="{Binding Category}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Badge -->
                                            <Border Grid.Column="2" Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FormatBadge}" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Border>

                                            <!-- Remove Button -->
                                            <Button Grid.Column="3" Click="RemoveImportedBook_Click" Tag="{Binding BookKey}"
                                                    VerticalAlignment="Center" Padding="8,6" ToolTipService.ToolTip="Remove book from library">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="#FF6B6B" />
                                                    <TextBlock Text="Remove" FontSize="12" Foreground="#FF6B6B" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>

                    <MenuFlyoutSeparator />

                    <!-- Custom Folder Structure & Organization -->
                    <StackPanel Spacing="12">
                        <TextBlock Text="Custom Book Folders &amp; Organization" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="Organize your library books into custom categories or folders (such as Japa Books, Scientific Books, Vaiṣṇava Etiquette, or personal topics)."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />

                        <!-- Add Folder Input -->
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="NewFolderNameBox" PlaceholderText="Enter new folder name (e.g. Japa Books)..." />
                            <Button Grid.Column="1" Click="AddCustomFolder_Click" Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE710;" FontSize="13" />
                                    <TextBlock Text="Add Folder" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Quick suggestion chips -->
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Suggestions:" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                            <HyperlinkButton Content="+ Japa Books" Click="QuickFolder_Click" Tag="Japa Books" Padding="4,2" FontSize="11" />
                            <HyperlinkButton Content="+ Scientific Books" Click="QuickFolder_Click" Tag="Scientific Books" Padding="4,2" FontSize="11" />
                            <HyperlinkButton Content="+ Vaiṣṇava Etiquette" Click="QuickFolder_Click" Tag="Vaiṣṇava Etiquette" Padding="4,2" FontSize="11" />
                            <HyperlinkButton Content="+ Daily Reading" Click="QuickFolder_Click" Tag="Daily Reading" Padding="4,2" FontSize="11" />
                        </StackPanel>

                        <!-- Folders & Order List -->
                        <TextBlock Text="Your Folders &amp; Order:" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0" />
                        <TextBlock Text="Rearrange the position of folders in the scripture library sidebar using the Move Up / Move Down buttons."
                                   FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <ListView x:Name="FoldersListView" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1" CornerRadius="6" Padding="12,6" Margin="0,2,0,2">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xED43;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <Button Click="MoveFolderUp_Click" Tag="{Binding Name}" Padding="6,4" ToolTipService.ToolTip="Move folder up in sidebar order">
                                                    <FontIcon Glyph="&#xE70E;" FontSize="10" />
                                                </Button>
                                                <Button Click="MoveFolderDown_Click" Tag="{Binding Name}" Padding="6,4" ToolTipService.ToolTip="Move folder down in sidebar order">
                                                    <FontIcon Glyph="&#xE70D;" FontSize="10" />
                                                </Button>
                                                <Button Click="DeleteFolder_Click" Tag="{Binding Name}"
                                                        Visibility="{Binding DeleteButtonVisibility}"
                                                        Padding="6,4" ToolTipService.ToolTip="Delete custom folder">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="#FF6B6B" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Reassign Books to Folders - Separate Per Folder -->
                        <TextBlock Text="Organize Books in Folder:" FontSize="12" FontWeight="SemiBold" Margin="0,10,0,0" />
                        <TextBlock Text="Select a folder to view and reorder its books separately. By default, books in each folder are arranged in alphabetical order (A–Z)."
                                   FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

                        <Grid ColumnSpacing="8" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="SelectedFolderToOrganizeComboBox"
                                      Header="Folder to Organize"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="SelectedFolderToOrganizeComboBox_SelectionChanged" />
                            <Button Grid.Column="1" Click="SortFolderAlphabetical_Click" VerticalAlignment="Bottom"
                                    ToolTipService.ToolTip="Reset books in this folder to alphabetical order (A–Z)">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8CB;" FontSize="13" />
                                    <TextBlock Text="Sort (A–Z)" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <TextBlock x:Name="NoBooksInFolderText" Text="No books currently in this folder." FontStyle="Italic" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" Visibility="Collapsed" Margin="0,4,0,0" />

                        <ListView x:Name="FolderBooksListView" SelectionMode="None" MaxHeight="340" Margin="0,4,0,0">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,3,0,3">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="180" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding BookKey}" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <Button Click="MoveFolderBookUp_Click" Tag="{Binding BookKey}" Padding="6,4" ToolTipService.ToolTip="Move up within this folder">
                                                    <FontIcon Glyph="&#xE70E;" FontSize="10" />
                                                </Button>
                                                <Button Click="MoveFolderBookDown_Click" Tag="{Binding BookKey}" Padding="6,4" ToolTipService.ToolTip="Move down within this folder">
                                                    <FontIcon Glyph="&#xE70D;" FontSize="10" />
                                                </Button>
                                            </StackPanel>
                                            <ComboBox Grid.Column="2" HorizontalAlignment="Stretch"
                                                      Header="Move to Folder"
                                                      ItemsSource="{Binding FolderOptions}"
                                                      SelectedIndex="{Binding SelectedFolderIndex, Mode=TwoWay}"
                                                      Tag="{Binding BookKey}"
                                                      SelectionChanged="FolderComboBox_SelectionChanged" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- About Prabhupāda Connect -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="16">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="72" Height="72" CornerRadius="36" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="2">
                            <Border.Background>
                                <ImageBrush ImageSource="ms-appx:///Assets/Square150x150Logo.scale-200.png" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="Prabhupāda Connect" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="The Modern Bhaktivedanta VedaBase Research Workstation"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" />
                            <TextBlock Text="Dedicated to His Divine Grace A.C. Bhaktivedanta Swami Prabhupāda"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Prabhupāda Connect is an open-source, ultra-fast research studio featuring the complete canon of Śrīla Prabhupāda's teachings, advanced Folio search, Sanskrit meter analysis, personal annotations, and cloud synchronization."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <HyperlinkButton Content="GitHub Repository (Contribute &amp; Star)"
                                         NavigateUri="https://github.com/itzabhinav01/prabhupada-connect" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Reset -->
            <Button x:Name="ResetFlyoutButton" Content="Reset to Defaults" HorizontalAlignment="Left">
                <Button.Flyout>
                    <Flyout>
                        <StackPanel Spacing="12" MaxWidth="280">
                            <TextBlock Text="Reset all reading preferences to their defaults?" TextWrapping="Wrap" />
                            <TextBlock Text="This resets Theme, Font Size, Reading Width, Line Spacing, Focus Mode, and Verse Content visibility only. Bookmarks, notes, and reading history are not affected."
                                       TextWrapping="Wrap" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button Content="Reset" Click="ResetButton_Click"
                                    Background="{ThemeResource SystemFillColorCriticalBrush}"
                                    Foreground="White" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>

            <ProgressBar IsIndeterminate="True"
                         Visibility="{x:Bind BoolToVis(ViewModel.IsLoading), Mode=OneWay}"
                         Margin="0,16,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Page>
