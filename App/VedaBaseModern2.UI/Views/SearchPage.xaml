<Page
    x:Class="VedaBaseModern.UI.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:VedaBaseModern.Core.Models"
    xmlns:services="using:VedaBaseModern.Core.Services"
    xmlns:helpers="using:VedaBaseModern.UI.Helpers"
    xmlns:converters="using:VedaBaseModern.UI.Converters"
    mc:Ignorable="d"
    KeyboardAcceleratorPlacementMode="Hidden"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisConverter" />
    </Page.Resources>

    <Page.KeyboardAccelerators>
        <!-- Esc -> clear the current query/results (AutoSuggestBox already
             closes its own suggestion popup on Escape natively; this handles
             clearing the query text and results on top of that). -->
        <KeyboardAccelerator Key="Escape" Invoked="EscapeAccelerator_Invoked" />
        <KeyboardAccelerator Key="S" Modifiers="Control,Shift" Invoked="AdvancedSearchAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid Margin="0,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0" Margin="0,0,0,24" MaxWidth="920" HorizontalAlignment="Stretch">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- Type '@' for direct-reference mode (e.g. "@BG 1.1", "@SB 1.4.6")
                     - see DirectReferenceService. UpdateSourceTrigger=PropertyChanged
                     is required so ViewModel.SearchText (and therefore
                     autocomplete) updates on every keystroke, not just on
                     focus-loss (AutoSuggestBox's TwoWay x:Bind default). -->
                <AutoSuggestBox x:Name="MainSearchBox" Grid.Column="0"
                                PlaceholderText="Search the VedaBase, or type @ to go to a verse..."
                                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                ItemsSource="{x:Bind ViewModel.ReferenceSuggestions, Mode=OneWay}"
                                TextMemberPath="DisplayText"
                                QueryIcon="Find"
                                QuerySubmitted="AutoSuggestBox_QuerySubmitted"
                                SuggestionChosen="AutoSuggestBox_SuggestionChosen"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,10,0"
                                Height="40" FontSize="15">
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate x:DataType="services:ReferenceSuggestion">
                            <StackPanel Orientation="Horizontal" Spacing="8" Padding="0,4">
                                <TextBlock Text="{x:Bind DisplayText}" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind SubText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>
                <ComboBox Grid.Column="1" ItemsSource="{x:Bind ViewModel.AvailableBooks, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedBookFilter, Mode=TwoWay}"
                          SelectionChanged="ComboBox_SelectionChanged"
                          DisplayMemberPath="Title"
                          HorizontalAlignment="Stretch" Height="40"
                          AutomationProperties.Name="Filter by book" ToolTipService.ToolTip="Filter by book" />
                <Button Grid.Column="2" x:Name="AdvancedSearchBtn" Click="AdvancedSearchBtn_Click"
                        Style="{StaticResource AccentButtonStyle}" Height="40" Padding="12,0" Margin="10,0,0,0"
                        ToolTipService.ToolTip="Folio Advanced Query, Word Wheel &amp; Checked Branches (Ctrl+Shift+S)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE71E;" FontSize="13" />
                        <TextBlock Text="⚡ Advanced Search" FontWeight="SemiBold" FontSize="12" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Facet filters & Researcher Precision Controls -->
            <Grid Margin="0,12,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <RadioButtons Grid.Row="0" Grid.Column="0" ItemsSource="{x:Bind ViewModel.FacetOptions, Mode=OneWay}"
                              SelectedIndex="{x:Bind ViewModel.SelectedFacetIndex, Mode=TwoWay}"
                              MaxColumns="5" />

                <!-- Secondary Researcher Bar: Exact Word Toggle, Match Case Toggle, Scope, Sort Order -->
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <CheckBox x:Name="MatchExactWordCheckBox" Content="Match Exact Word"
                              IsChecked="{x:Bind ViewModel.IsExactWordMatch, Mode=TwoWay}"
                              VerticalAlignment="Center"
                              ToolTipService.ToolTip="Match whole word only (like browser find) — eliminates partial word matches" />

                    <CheckBox x:Name="MatchExactCaseCheckBox" Content="Match Case"
                              IsChecked="{x:Bind ViewModel.IsExactCaseMatch, Mode=TwoWay}"
                              VerticalAlignment="Center"
                              ToolTipService.ToolTip="Match exact letter case (e.g. tat vs Tat) — eliminates case variants" />


                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="Scope:" VerticalAlignment="Center" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ComboBox ItemsSource="{x:Bind ViewModel.FieldScopeOptions, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedFieldScope, Mode=TwoWay}"
                                  Width="175" Height="36"
                                  ToolTipService.ToolTip="Scope search to Verse &amp; Synonyms, Purports, Translations, etc." />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="Sort:" VerticalAlignment="Center" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ComboBox ItemsSource="{x:Bind ViewModel.SortOptions, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedSortOption, Mode=TwoWay}"
                                  Width="175" Height="36"
                                  ToolTipService.ToolTip="Sort by Best Match / Relevance or Canonical Scriptural Order" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" 
                       Style="{StaticResource BodyTextBlockStyle}" 
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                       Margin="0,12,0,0" />
            <ProgressBar IsIndeterminate="True" 
                         Visibility="{x:Bind BoolToVis(ViewModel.IsLoading), Mode=OneWay}" 
                         Margin="0,8,0,0"/>
        </StackPanel>

        <!-- Results -->
        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}"
                  SelectionChanged="Result_SelectionChanged"
                  MaxWidth="800" HorizontalAlignment="Stretch"
                  Visibility="{x:Bind InverseBoolToVis(ViewModel.IsLoading), Mode=OneWay}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:SearchResult">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="16,12"
                            Margin="0,4"
                            HorizontalAlignment="Stretch">
                        <StackPanel Spacing="6">
                            <!-- Header: Reference (bold gold), Context and Optional Exact Match Badge -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Reference in prominent Gold/Accent -->
                                <TextBlock Grid.Column="0" Text="{x:Bind Reference}" FontWeight="Bold" FontSize="16" 
                                           Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />

                                <!-- Book Context -->
                                <TextBlock Grid.Column="1" Text="{x:Bind BookTitle}" FontSize="12" 
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                <!-- Badges (Exact Citation Match / Category) -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                    <Border Visibility="{Binding IsExactMatch, Converter={StaticResource BoolToVisConverter}}"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="Exact Match" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource ApplicationPageBackgroundThemeBrush}" />
                                    </Border>
                                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="{x:Bind Category}" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- Snippet with Search Highlighting -->
                            <TextBlock helpers:HighlightHelper.FormattedText="{x:Bind Preview}" 
                                       TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" 
                                       FontSize="14" LineHeight="20" LineStackingStrategy="BlockLineHeight"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.Footer>
                <StackPanel HorizontalAlignment="Center" Margin="0,16,0,32"
                            Visibility="{x:Bind BoolToVis(ViewModel.HasMoreResults), Mode=OneWay}">
                    <Button Content="{x:Bind ViewModel.LoadMoreButtonText, Mode=OneWay}"
                            Command="{x:Bind ViewModel.LoadMoreCommand}"
                            IsEnabled="{x:Bind Not(ViewModel.IsLoadingMore), Mode=OneWay}"
                            HorizontalAlignment="Center"
                            Padding="24,8"
                            CornerRadius="6"
                            Style="{StaticResource AccentButtonStyle}"
                            FontWeight="SemiBold" />
                    <ProgressBar IsIndeterminate="True" 
                                 Visibility="{x:Bind BoolToVis(ViewModel.IsLoadingMore), Mode=OneWay}"
                                 Margin="0,8,0,0" Width="200" />
                </StackPanel>
            </ListView.Footer>
        </ListView>
    </Grid>
</Page>
