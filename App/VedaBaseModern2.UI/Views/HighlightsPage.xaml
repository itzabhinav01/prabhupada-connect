<Page
    x:Class="VedaBaseModern.UI.Views.HighlightsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:VedaBaseModern.UI.ViewModels"
    xmlns:converters="using:VedaBaseModern.UI.Converters"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <converters:HighlightColorToBrushConverter x:Key="HighlightColorToBrushConverter" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16" MaxWidth="1150" HorizontalAlignment="Stretch" Padding="24,0">
            <TextBlock Text="Highlights" Style="{StaticResource TitleTextBlockStyle}" />
            <ProgressBar IsIndeterminate="True"
                         Visibility="{x:Bind BoolToVis(ViewModel.IsLoading), Mode=OneWay}"
                         Margin="0,8,0,0"/>
        </StackPanel>

        <!-- Phase 4.9.6: Search and Filter Bar - Search + Scripture + Color, combined.
             Composed client-side in HighlightsViewModel with zero database locks and zero corpus mutations. -->
        <Grid Grid.Row="1" Margin="0,0,0,16" MaxWidth="1150" HorizontalAlignment="Stretch" Padding="24,0"
              Visibility="{x:Bind CountToVis(ViewModel.Highlights.Count), Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox Grid.Column="0" Margin="0,0,8,0"
                            PlaceholderText="Search highlights..."
                            Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            QueryIcon="Find"
                            AutomationProperties.Name="Search highlights" />
            <ComboBox Grid.Column="1" Margin="0,0,8,0"
                      ItemsSource="{x:Bind ViewModel.ScriptureFilterOptions, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedScriptureFilter, Mode=TwoWay}"
                      Width="200"
                      AutomationProperties.Name="Filter highlights by scripture">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ScriptureFilterOption">
                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <ComboBox Grid.Column="2" Margin="0,0,12,0"
                      ItemsSource="{x:Bind ViewModel.ColorFilterOptions, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedColorFilter, Mode=TwoWay}"
                      Width="130"
                      AutomationProperties.Name="Filter highlights by color">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ColorFilterOption">
                        <TextBlock Text="{x:Bind Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Grid.Column="3" Text="{x:Bind ViewModel.FilteredCountText, Mode=OneWay}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center" HorizontalAlignment="Right" />
        </Grid>

        <!-- No highlights at all yet. -->
        <StackPanel Grid.Row="2" MaxWidth="1150" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Spacing="8"
                    Visibility="{x:Bind ShowEmptyState(ViewModel.IsLoading, ViewModel.Highlights.Count), Mode=OneWay}">
            <TextBlock Text="No highlights yet." Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
            <TextBlock Text="Highlight a passage in Reading View to find it here."
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Compact empty state for current filter/search combination -->
        <StackPanel Grid.Row="2" MaxWidth="1150" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Spacing="6"
                    Visibility="{x:Bind ShowFilterEmptyState(ViewModel.IsFilterEmpty, ViewModel.Highlights.Count), Mode=OneWay}">
            <TextBlock Text="No highlights match this filter or search." Style="{StaticResource SubtitleTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="Try adjusting your search terms, scripture, or color filter." Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
        </StackPanel>

        <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.FilteredHighlights, Mode=OneWay}"
                  SelectionChanged="Result_SelectionChanged"
                  MaxWidth="1150" HorizontalAlignment="Stretch" Padding="24,0,24,24"
                  Visibility="{x:Bind ShowFilteredResults(ViewModel.IsFilterEmpty, ViewModel.Highlights.Count), Mode=OneWay}">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0,2" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:HighlightListItem">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,3"
                            HorizontalAlignment="Stretch">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- Visual highlight color indicator bar -->
                            <Border Grid.Column="0" Width="5" CornerRadius="2.5" Margin="0,0,12,0"
                                    Background="{x:Bind Color, Converter={StaticResource HighlightColorToBrushConverter}}" />
                            <StackPanel Grid.Column="1" Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Reference}" FontWeight="Bold" FontSize="14" />
                                    <TextBlock Text="•" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind BookTitle}" FontWeight="Normal" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                                    <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="3" Padding="6,1" Margin="4,0,0,0">
                                        <TextBlock Text="{x:Bind FieldDisplay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{x:Bind SnippetDisplay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="13.5" FontStyle="Italic" LineHeight="20" />
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Border Background="{x:Bind Color, Converter={StaticResource HighlightColorToBrushConverter}}" CornerRadius="3" Padding="6,1">
                                        <TextBlock Text="{x:Bind ColorDisplayName}" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                    </Border>
                                    <TextBlock Text="{x:Bind CreatedDisplay}" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="2" VerticalAlignment="Top" Style="{StaticResource TextBlockButtonStyle}"
                                    Click="RemoveHighlight_Click" Tag="{x:Bind Id}"
                                    ToolTipService.ToolTip="Remove this highlight" AutomationProperties.Name="Remove highlight">
                                <FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
